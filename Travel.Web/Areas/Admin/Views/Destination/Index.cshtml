@model List<ResultDestinationDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.TopbarTitle = "Tur Yönetimi";
    int count = 0;
}

<div class="crumb"><a href="#">Dashboard</a> / <span class="cur">Turlar</span></div>
<div class="page-intro">
    <div>
        <h1>Destinasyonlar</h1>
        <p>Destinasyon ile ilgili işlemlerinizi buradan yürütebilirsiniz.</p>
    </div>
</div>

<div class="card-x mb-3">
    <div class="tbl-wrap">
        <table class="tx">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Görsel</th>
                    <th>Ad</th>
                    <th>Ülke</th>
                    <th>Açıklama</th>
                    <th>Popüler mi?</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>
                            <img style="width:120px; height:70px; border-radius:8px; object-fit:cover;" src="@item.ImageUrl" />
                        </td>
                        <td><b>@item.Name</b></td>
                        <td>@item.Country</td>
                        <td>
                            @(item.Description != null && item.Description.Length > 50
                                ? item.Description.Substring(0, 50) + "..."
                                : item.Description)
                        </td>
                        <td>
                            @if (item.IsPopular)
                            {
                                <span class="badge-x b-ok">Evet</span>
                            }
                            else
                            {
                                <span class="badge-x b-cancel">Hayır</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Delete" asp-controller="Destination"
                               asp-route-id="@item.Id" class="btn-soft">Sil</a>
                            <a href="/Admin/Destination/Update/@item.Id"
                               class="btn-soft">Güncelle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a href="/Admin/Destination/Create" class="btn-teal">Yeni Destination</a>

