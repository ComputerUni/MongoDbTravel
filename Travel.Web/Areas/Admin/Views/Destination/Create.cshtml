@model CreateDestinationDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.TopbarTitle = "Tur Yönetimi";
}

<div class="crumb"><a href="#">Dashboard</a> / <span class="cur">Turlar</span></div>
<div class="page-intro">
    <div>
        <h1>Yeni Destinasyon</h1>
        <p>Yeni bir destinasyon ekleyin.</p>
    </div>
</div>

<form asp-action="Create" asp-controller="Destination" method="post" enctype="multipart/form-data">
    <div class="sec">
        <div class="sec-head">
            <h2>Temel Bilgiler</h2>
            <p>Destinasyonun görünen bilgilerini girin.</p>
        </div>

        <div class="row g-3">
            <div class="col-md-6 field">
                <label asp-for="Name">Destinasyon Adı (TR) <span class="req">*</span></label>
                <input class="ctrl" asp-for="Name" placeholder="Örn. Roma">
            </div>
            <div class="col-md-6 field">
                <label asp-for="NameEn">Destination Name (EN)</label>
                <input class="ctrl" asp-for="NameEn" placeholder="e.g. Rome">
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6 field">
                <label asp-for="Country">Ülke Adı (TR) <span class="req">*</span></label>
                <input class="ctrl" asp-for="Country" placeholder="Örn: İtalya">
            </div>
            <div class="col-md-6 field">
                <label asp-for="CountryEn">Country Name (EN)</label>
                <input class="ctrl" asp-for="CountryEn" placeholder="e.g. Italy">
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6 field">
                <label asp-for="Description">Açıklama (TR)</label>
                <textarea asp-for="Description" class="ctrl" rows="4" placeholder="Destinasyon hakkında kısa bilgi..."></textarea>
            </div>
            <div class="col-md-6 field">
                <label asp-for="DescriptionEn">Description (EN)</label>
                <textarea asp-for="DescriptionEn" class="ctrl" rows="4" placeholder="Short info about the destination..."></textarea>
            </div>
        </div>

        <div class="field">
            <label>Görsel</label>
            <label class="upload" for="imageInput">
                <div class="uic">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                </div>
                <b>Görsel buraya sürükleyin veya seçin.</b>
                <span>JPG, PNG</span>
            </label>
            <input type="file" id="imageInput" asp-for="ImageUrl" accept="image/*" hidden onchange="previewCover(this)">
            <div class="cover-preview" id="coverPreview" style="display:none">
                <img id="coverImg" alt="Önizleme">
            </div>
        </div>
        <div class="field form-check">
            <input type="checkbox" class="form-check-input" asp-for="IsPopular">
            <label class="form-check-label" asp-for="IsPopular">Popüler destinasyon olarak işaretle</label>
        </div>

        <button type="submit" class="btn-teal">Kaydet</button>

    </div>

</form>

