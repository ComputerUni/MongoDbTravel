@using System.Security.Claims

<div class="page-intro">
    <div>
        <div class="eyebrow">Genel Bakış</div>
        <h1>Hoş Geldiniz, @User.FindFirstValue("FirstName") 👋</h1>
        <p>Travelio platformundaki son gelişmeleri ve önemli verileri buradan takip edebilirsiniz.</p>
    </div>
    <div class="date-pill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
        @DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
    </div>
</div>

@await Component.InvokeAsync("_AdminDashboardKpi")

<div class="row g-3 mb-3">

    @await Component.InvokeAsync("_AdminDashboardChart")

    @await Component.InvokeAsync("_AdminDashboardPopularTours")

</div>

@await Component.InvokeAsync("_AdminDashboardRecentReservations")

<div class="row g-3">

    @await Component.InvokeAsync("_AdminDashboardRecentReviews")

    @await Component.InvokeAsync("_AdminDashboardPendingQuestions")

    @await Component.InvokeAsync("_AdminDashboardQuickActions")

</div>