@model List<ResultRouteDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
}

<h1>Rotalar</h1>

<form method="post" asp-action="Index" asp-controller="Route">
    <input type="text" name="city" placeholder="Şehir İsmini Buraya Yazınız..." />
    <button type="submit" class="btn btn-outline-dark"><i class="bi bi-filter"></i>Ara</button>
</form>

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>Görsel</th>
        <th>Ülke</th>
        <th>Şehir</th>
        <th>Tur Süresi</th>
        <th>Fiyat</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td><img style="width:300px; height:150px; display:flex; justify-content:center; align-items:center; " src="@item.ImageUrl" class="img-thumbnail" alt="@item.ImageUrl" /></td>
            <td>@item.Country</td>
            <td>@item.City</td>
            <td>@item.Duration</td>
            <td>@item.Price ₺</td>
            <td>
                <a href="/Admin/Route/Delete/@item.Id" onclick="return confirm('Silmek istediğinize emin misiniz?')" class="btn btn-outline-danger">Sil</a>
                <a href="/Admin/Route/Update/@item.Id" class="btn btn-outline-primary">Güncelle</a>
            </td>
        </tr>
    }

</table>

<a href="/Admin/Route/Create" class="btn btn-outline-success">Yeni Rota Ekle</a>