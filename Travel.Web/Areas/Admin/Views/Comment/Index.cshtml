@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.TopbarTitle = "Tur Yönetimi";
}

@await Component.InvokeAsync("_AdminTourHead")


<div class="crumb"><a href="/Admin/Dashboard/Index">Dashboard</a> / <span class="cur">Yorumlar</span></div>
<div class="page-intro">
    <div>
        <h1>Yorum Yönetimi</h1>
        <p>Travelio'daki tüm yorunları görüntüleyebilir, filtreleyebilir ve yönetebilirsiniz.</p>
    </div>
</div>



@await Component.InvokeAsync("_AdminCommentKpi")
@await Component.InvokeAsync("_AdminCommentFilter")
@await Component.InvokeAsync("_AdminTourBulkBar")
@await Component.InvokeAsync("_AdminCommentTable", new { page = int.TryParse(Context.Request.Query["page"], out var p) ? p : 1 })
@await Component.InvokeAsync("_AdminTourDeleteModal")
@await Component.InvokeAsync("_AdminCommentScript")
