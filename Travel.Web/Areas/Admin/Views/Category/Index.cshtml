@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ResultCategoryDto>


@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.TopbarTitle = "Kategori Yönetimi";
    int count = 0;
}

<div class="crumb"><a href="#">Kategoriler</a> / <span class="cur">Kategori Listesi</span></div>
<div class="page-intro">
    <div>
        <h1>Kategoriler</h1>
        <p>Kategori ile ilgili işlemlerinizi buradan yürütebilirsiniz.</p>
    </div>
</div>

<div class="card-x mb-3">
    <div class="tbl-wrap">
        <table class="tx">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kategori Adı</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.CategoryName</td>
                        <td>
                            <a asp-action="Delete" asp-controller="Category"
                               asp-route-id="@item.Id" class="btn-soft">Sil</a>
                            <a href="/Admin/Category/Update/@item.Id"
                               class="btn-soft">Güncelle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pager-row" id="pagerRow">
        <div class="per-page">
            Toplam @Model.TotalItemCount kayıttan @Model.FirstItemOnPage - @Model.LastItemOnPage arası gösteriliyor.
        </div>
        <div class="pager">
            @Html.PagedListPager(Model, page => Url.Action("Index", "Category", new { area = "Admin", page }), new PagedListRenderOptions
            {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                DisplayLinkToFirstPage = PagedListDisplayMode.Never,
                DisplayLinkToLastPage = PagedListDisplayMode.Never,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
            })
        </div>
    </div>
</div>

<a href="/Admin/Category/Create" class="btn-teal">Yeni Kategori</a>

