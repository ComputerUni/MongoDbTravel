@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.TopbarTitle = "Rezervasyon Yönetimi";
}

@await Component.InvokeAsync("_AdminTourHead")


<div class="crumb"><a href="/Admin/Dashboard/Index">Dashboard</a> / <span class="cur">Rezervasyonlar</span></div>
<div class="page-intro">
    <div>
        <h1>Rezervasyon Yönetimi</h1>
        <p>Travelio'daki tüm rezervasyonları görüntüleyebilir, filtreleyebilir ve yönetebilirsiniz.</p>
    </div>
</div>

@await Component.InvokeAsync("_AdminReservationKpi")
@await Component.InvokeAsync("_AdminReservationFilter")
@await Component.InvokeAsync("_AdminTourBulkBar")
@await Component.InvokeAsync("_AdminReservationTable", new { page = int.TryParse(Context.Request.Query["page"], out var p) ? p : 1 })
@await Component.InvokeAsync("_AdminTourDeleteModal")
@await Component.InvokeAsync("_AdminReservationScript")
