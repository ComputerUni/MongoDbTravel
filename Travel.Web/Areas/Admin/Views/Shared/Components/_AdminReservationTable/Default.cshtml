@model List<ResultReservationDto>

<div class="card-x mb-3">
    <div class="tbl-wrap">
        <table class="tx">
            <thead>
                <tr>
                    <th style="width:36px"><input type="checkbox" class="chk" id="checkAll" onchange="toggleAll(this)"></th>
                    <th>Rezervasyon ID</th>
                    <th>Tur Adı & Görsel</th>
                    <th>Kullanıcı</th>
                    <th>Destinasyon</th>
                    <th>Tur Tarih Aralığı</th>
                    <th>Rezervasyon Tarihi</th>
                    <th>Kişi</th>
                    <th>Toplam Ücret</th>
                    <th>Durum</th>
                    <th style="width:140px">İşlemler</th>
                </tr>
            </thead>
            <tbody id="tourRows">
                @foreach (var reservation in Model)
                {
                    <tr>
                        <td><input type="checkbox" class="chk row-chk" value="@reservation.Id" /></td>
                        <td><span class="text-primary fw-bold">TRV-@reservation.Id.Substring(0, 8).ToUpper()</span></td>

                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                @if (!string.IsNullOrEmpty(reservation.CoverImage))
                                {
                                    <img src="@reservation.CoverImage" alt="@reservation.TourName" style="width:36px; height:36px; border-radius:6px; object-fit:cover;" />
                                }
                                <div>
                                    <b>@reservation.TourName</b>
                                </div>
                            </div>
                        </td>
                        <td>@reservation.UserFullName <span class="text-primary fw-bold">@reservation.UserEmail</span></td>
                        <td>@reservation.DestinationName</td>
                        <td>@reservation.TourDate.ToLocalTime().ToString("dd MMM") - @reservation.TourDate.AddDays(reservation.Duration).ToString("dd MMM yyyy")</td>
                        <td><small class="text-muted">@reservation.CreatedAt.ToString("dd MMM yyyy HH:mm")</small></td>
                        <td>
                            <span class="badge bg-light text-dark">@reservation.AdultCount Yetişkin</span>
                            @if (reservation.ChildCount > 0)
                            {
                                <span class="badge bg-light text-dark">@reservation.ChildCount Çocuk</span>
                            }
                        </td>
                        <td><b>@reservation.TotalPrice.ToString("N2") TL</b></td>
                        <td>
                            @if (reservation.Status.ToString() == "Onaylandı")
                            {
                                <span class="badge bg-success">Onaylandı</span>
                            }
                            else if (reservation.Status.ToString() == "İptal")
                            {
                                <span class="badge bg-danger">İptal Edildi</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Bekliyor</span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-success" onclick="updateStatus('@reservation.Id', 'Onaylandı')" title="Onayla">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="updateStatus('@reservation.Id', 'İptal')" title="İptal Et">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="emptyState" style="display:none">
        <div class="empty">
            <div class="eic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></div>
            <h3>Tur bulunamadı</h3>
            <p>Arama veya filtre kriterlerinizi değiştirerek tekrar deneyebilirsiniz.</p>
            <button class="btn-teal" style="margin:0 auto" onclick="clearFilters()">Filtreleri Temizle</button>
        </div>
    </div>
    <div class="pager-row" id="pagerRow">
        <div class="per-page">
            Sayfa başına
            <select id="perPage"><option>10</option><option>25</option><option>50</option></select>
        </div>
        <div class="pager">
            <a href="#" class="disabled">Önceki</a>
            <a href="#" class="active">1</a>
            <a href="#">2</a>
            <a href="#">3</a>
            <a href="#">4</a>
            <a href="#">Sonraki</a>
        </div>
    </div>
</div>