@model QuestionKpiDto

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <div>
                <div class="num">@Model.TotalQuestionCount</div>
                <div class="lab">Toplam Soru</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    <polyline points="9 10 11 12 15 8"></polyline>
                </svg>
            </div>
            <div>
                <div class="num">@Model.AnsweredQuestionCount</div>
                <div class="lab">Cevaplanan Soru</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic gray">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div>
                <div class="num">@Model.PendingQuestionCount</div>
                <div class="lab">Cevap Bekleyen</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="5" x2="5" y2="19"></line>
                    <circle cx="6.5" cy="6.5" r="2.5"></circle>
                    <circle cx="17.5" cy="17.5" r="2.5"></circle>
                </svg>
            </div>
            <div>
                <div class="num">%@Model.ResponseRate.ToString("0.0")</div>
                <div class="lab">Cevaplanma Oranı</div>
            </div>
        </div>
    </div>
</div>