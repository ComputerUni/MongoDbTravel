@model List<ResultTourDto>

<div class="card-x mb-3">
    <div class="tbl-wrap">
        <table class="tx">
            <thead>
                <tr>
                    <th style="width:36px"><input type="checkbox" class="chk" id="checkAll" onchange="toggleAll(this)"></th>
                    <th class="sortable" onclick="sortBy('title')">Tur <span class="sar">↕</span></th>
                    <th>Kategori</th>
                    <th>Süre</th>
                    <th class="sortable" onclick="sortBy('price')">Fiyat <span class="sar">↕</span></th>
                    <th class="sortable" onclick="sortBy('date')">Yaklaşan Tarih <span class="sar">↕</span></th>
                    <th>Kontenjan</th>
                    <th class="sortable" onclick="sortBy('res')">Rezervasyon <span class="sar">↕</span></th>
                    <th>Durum</th>
                    <th style="width:56px">İşlemler</th>
                </tr>
            </thead>
            <tbody id="tourRows">
                @foreach (var tour in Model)
                {
                    <tr>
                        <td><input type="checkbox" class="chk row-chk" value="@tour.Id" /></td>
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                @if (!string.IsNullOrEmpty(tour.CoverImage))
                                {
                                    <img src="@tour.CoverImage" alt="@tour.Name" style="width:36px; height:36px; border-radius:6px; object-fit:cover;" />
                                }
                                <div>
                                    <b>@tour.Name</b>
                                    <span style="display:block; font-size:11px; color:#6a7c88;">@tour.Route</span>
                                </div>
                            </div>
                        </td>
                        <td>@tour.CategoryName</td>
                        <td>@tour.Duration gün / @tour.Night gece</td>
                        <td><span style="font-weight:600; color:var(--navy);">@tour.Price.ToString("N0") TL</span></td>
                       <td>
     @if (tour.Dates != null && tour.Dates.Any() && tour.IsActive == "Aktif")
     {
         var activeDates = tour.Dates.Where(d => d.IsActive).ToList();
         @if (activeDates.Any()) 
         {
             @activeDates.Min(d => d.StartDate).ToLocalTime().ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
         }
         else 
         {
             <span style="color:#999;">Aktif Tarih Yok</span>
         }
     }
     else 
     {
         <span style="color:#999;">Aktif Tarih Yok</span>
     }
 </td>
                        <td>
                            @if (tour.Dates != null && tour.Dates.Any())
                            {
                                var firstDate = tour.Dates.OrderBy(d => d.StartDate).FirstOrDefault();
                                <span>@(firstDate?.Quota) Kişi</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>-</td>
                        <td>
                            @if (tour.IsActive == "Aktif")
                            {
                                <span class="badge-x b-ok">Aktif</span>
                            }
                            else if (tour.IsActive == "Pasif")
                            {
                                <span class="badge-x b-cancel">Pasif</span>
                            }
                            else
                            {
                                <span class="badge-x b-wait">Taslak</span>
                            }
                        </td>

                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="@Url.Action("Update", "Tour", new { id = tour.Id, area = "Admin" })" class="btn-mini" title="Düzenle">✏️</a>
                                <a href="@Url.Action("Delete", "Tour", new { id = tour.Id, area = "Admin" })" class="btn-mini text-danger" title="Sil" onclick="return confirm('Bu turu silmek istediğinize emin misiniz?');">🗑️</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="emptyState" style="display:none">
        <div class="empty">
            <div class="eic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></div>
            <h3>Tur bulunamadı</h3>
            <p>Arama veya filtre kriterlerinizi değiştirerek tekrar deneyebilirsiniz.</p>
            <button class="btn-teal" style="margin:0 auto" onclick="clearFilters()">Filtreleri Temizle</button>
        </div>
    </div>
    <div class="pager-row" id="pagerRow">
        <div class="per-page">
            Sayfa başına
            <select id="perPage"><option>10</option><option>25</option><option>50</option></select>
        </div>
        <div class="pager">
            <a href="#" class="disabled">Önceki</a>
            <a href="#" class="active">1</a>
            <a href="#">2</a>
            <a href="#">3</a>
            <a href="#">4</a>
            <a href="#">Sonraki</a>
        </div>
    </div>
</div>