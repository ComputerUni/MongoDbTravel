<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Tur Yönetimi — Travelio Admin</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{
    --navy:#0e2a3b;--navy-2:#12384c;--navy-3:#1b455c;--teal:#0fa3a3;--teal-dark:#0b7f80;
    --cream:#f7f5f0;--bg:#f4f5f4;--white:#fff;--ink:#0e2a3b;--muted:#6a7c88;--line:#e7e2d8;--line-2:#eef0ef;
    --shadow-sm:0 4px 18px rgba(14,42,59,.06);--shadow-md:0 18px 50px rgba(14,42,59,.12);
    --sidebar-w:266px;--r:16px;
    --ok-bg:#e3f4f0;--ok-fg:#0b7f80;
    --wait-bg:#fbf1dc;--wait-fg:#a9741a;
    --cancel-bg:#f6e4e2;--cancel-fg:#b45a4f;
  }
  *{box-sizing:border-box}
  body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:var(--bg);margin:0;-webkit-font-smoothing:antialiased}
  h1,h2,h3,h4,.brand{font-family:'Sora',sans-serif}
  a{text-decoration:none}
  .eyebrow{font-family:'Sora',sans-serif;text-transform:uppercase;letter-spacing:.2em;font-size:.7rem;font-weight:700;color:var(--teal-dark)}

  /* ============ SIDEBAR (birebir korunuyor) ============ */
  .sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:var(--navy);display:flex;flex-direction:column;z-index:1045;}
  .sb-brand{padding:1.5rem 1.5rem 1.3rem;display:flex;align-items:center;gap:.65rem;border-bottom:1px solid rgba(255,255,255,.08)}
  .sb-brand .dot{width:11px;height:11px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 4px rgba(15,163,163,.22);flex:none}
  .sb-brand .txt b{font-family:'Sora';font-weight:800;color:#fff;font-size:1.25rem;letter-spacing:-.4px;display:block;line-height:1}
  .sb-brand .txt span{font-size:.7rem;color:#7fe3e3;letter-spacing:.16em;text-transform:uppercase;font-weight:600}
  .sb-menu{flex:1;overflow-y:auto;padding:1rem .8rem;display:flex;flex-direction:column;gap:.15rem}
  .sb-cap{font-size:.68rem;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.35);font-weight:600;padding:.4rem .8rem .3rem}
  .sb-link{display:flex;align-items:center;gap:.75rem;padding:.65rem .85rem;border-radius:11px;color:rgba(255,255,255,.72);font-weight:500;font-size:.92rem;transition:.18s;position:relative}
  .sb-link svg{flex:none;opacity:.85}
  .sb-link:hover{background:rgba(255,255,255,.07);color:#fff}
  .sb-link.active{background:var(--teal);color:#fff;box-shadow:0 8px 20px rgba(15,163,163,.28)}
  .sb-link.active svg{opacity:1}
  .sb-badge{margin-left:auto;background:rgba(255,255,255,.16);color:#fff;font-size:.7rem;font-weight:700;padding:.1rem .45rem;border-radius:999px}
  .sb-link.active .sb-badge{background:rgba(255,255,255,.25)}
  .sb-foot{padding:.8rem;border-top:1px solid rgba(255,255,255,.08)}
  .sb-user{display:flex;align-items:center;gap:.7rem;padding:.6rem .7rem;border-radius:12px;background:rgba(255,255,255,.05)}
  .sb-user .av{width:38px;height:38px;border-radius:10px;background:var(--teal);color:#fff;display:grid;place-items:center;font-family:'Sora';font-weight:700;font-size:.85rem;flex:none}
  .sb-user b{display:block;color:#fff;font-size:.86rem;font-family:'Sora';line-height:1.2}
  .sb-user span{font-size:.74rem;color:rgba(255,255,255,.55)}

  /* ============ MAIN ============ */
  .main{margin-left:var(--sidebar-w);min-height:100vh;display:flex;flex-direction:column}
  .topbar{position:sticky;top:0;z-index:1030;background:rgba(244,245,244,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:.85rem 1.8rem;display:flex;align-items:center;gap:1rem;}
  .hamb{display:none;background:#fff;border:1px solid var(--line);border-radius:10px;width:40px;height:40px;place-items:center;color:var(--navy);cursor:pointer}
  .topbar .tb-title{font-family:'Sora';font-weight:700;font-size:1.05rem;color:var(--navy)}
  .tb-search{margin-left:.5rem;position:relative;flex:1;max-width:320px}
  .tb-search svg{position:absolute;left:.8rem;top:50%;transform:translateY(-50%);color:var(--muted)}
  .tb-search input{width:100%;border:1px solid var(--line);background:#fff;border-radius:999px;padding:.55rem .9rem .55rem 2.3rem;font-size:.88rem;outline:none;color:var(--navy)}
  .tb-search input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(15,163,163,.1)}
  .tb-right{margin-left:auto;display:flex;align-items:center;gap:.9rem}
  .tb-icon{position:relative;width:40px;height:40px;border-radius:11px;background:#fff;border:1px solid var(--line);display:grid;place-items:center;color:var(--navy);cursor:pointer;transition:.2s}
  .tb-icon:hover{border-color:var(--teal);color:var(--teal-dark)}
  .tb-icon .n-badge{position:absolute;top:-5px;right:-5px;background:#e0575b;color:#fff;font-size:.66rem;font-weight:700;min-width:17px;height:17px;border-radius:999px;display:grid;place-items:center;padding:0 3px}
  .tb-user{display:flex;align-items:center;gap:.6rem;padding-left:.4rem}
  .tb-user .av{width:38px;height:38px;border-radius:10px;background:var(--navy);color:#fff;display:grid;place-items:center;font-family:'Sora';font-weight:700;font-size:.82rem}
  .tb-user .nm{line-height:1.15}
  .tb-user .nm b{font-family:'Sora';font-size:.86rem;color:var(--navy);display:block}
  .tb-user .nm span{font-size:.74rem;color:var(--muted)}

  .content{padding:1.8rem;flex:1}
  .crumb{font-size:.8rem;color:var(--muted);margin-bottom:.4rem}
  .crumb a{color:var(--muted)} .crumb a:hover{color:var(--teal-dark)} .crumb .cur{color:var(--navy);font-weight:600}
  .page-intro{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
  .page-intro h1{font-weight:700;font-size:1.7rem;color:var(--navy);margin:.15rem 0 .3rem}
  .page-intro p{color:var(--muted);margin:0;font-size:.94rem;max-width:60ch}
  .btn-teal{background:var(--teal);color:#fff;border:none;border-radius:999px;font-weight:600;padding:.7rem 1.3rem;font-size:.9rem;transition:.25s;display:inline-flex;align-items:center;gap:.5rem;white-space:nowrap}
  .btn-teal:hover{background:var(--teal-dark);color:#fff;box-shadow:0 12px 26px rgba(15,163,163,.3)}

  /* KPI mini */
  .kpi{background:#fff;border:1px solid var(--line-2);border-radius:var(--r);box-shadow:var(--shadow-sm);padding:1rem 1.1rem;height:100%;display:flex;align-items:center;gap:.85rem}
  .kpi .ic{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;background:rgba(15,163,163,.1);color:var(--teal-dark);flex:none}
  .kpi .ic.gray{background:rgba(106,124,136,.12);color:var(--muted)}
  .kpi .ic.warn{background:rgba(169,116,26,.12);color:#a9741a}
  .kpi .num{font-family:'Sora';font-weight:800;font-size:1.4rem;color:var(--navy);line-height:1}
  .kpi .lab{font-size:.82rem;color:var(--muted);margin-top:.15rem}

  /* CARD */
  .card-x{background:#fff;border:1px solid var(--line-2);border-radius:var(--r);box-shadow:var(--shadow-sm)}

  /* FILTER BAR */
  .filter-bar{padding:1rem 1.1rem}
  .f-search{position:relative}
  .f-search svg{position:absolute;left:.85rem;top:50%;transform:translateY(-50%);color:var(--muted)}
  .f-search input{width:100%;border:1px solid var(--line);background:var(--cream);border-radius:11px;padding:.62rem .9rem .62rem 2.3rem;font-size:.9rem;outline:none;color:var(--navy)}
  .f-search input:focus{border-color:var(--teal);background:#fff;box-shadow:0 0 0 3px rgba(15,163,163,.1)}
  .f-select{width:100%;border:1px solid var(--line);background:#fff;border-radius:11px;padding:.62rem 2rem .62rem .9rem;font-size:.88rem;font-weight:500;color:var(--navy);outline:none;cursor:pointer}
  .f-select:focus{border-color:var(--teal)}
  .btn-clear{background:#fff;border:1px solid var(--line);border-radius:11px;padding:.62rem 1rem;font-size:.86rem;font-weight:600;color:var(--muted);cursor:pointer;transition:.2s;white-space:nowrap;width:100%}
  .btn-clear:hover{border-color:var(--cancel-fg);color:var(--cancel-fg)}

  .result-line{font-size:.86rem;color:var(--muted);margin:.2rem 0 1rem;padding:0 .2rem}
  .result-line b{color:var(--navy);font-weight:600}

  /* BULK BAR */
  .bulk-bar{display:none;align-items:center;gap:.8rem;background:var(--navy);color:#fff;border-radius:12px;padding:.6rem 1rem;margin-bottom:1rem}
  .bulk-bar.show{display:flex}
  .bulk-bar b{font-family:'Sora';font-size:.9rem}
  .bulk-bar .bulk-btn{margin-left:auto;background:rgba(255,255,255,.12);border:none;color:#fff;border-radius:999px;padding:.35rem .9rem;font-size:.82rem;font-weight:600;cursor:pointer;transition:.2s}
  .bulk-bar .bulk-btn+.bulk-btn{margin-left:.5rem}
  .bulk-bar .bulk-btn:hover{background:rgba(255,255,255,.22)}
  .bulk-bar .bulk-btn.danger:hover{background:var(--cancel-fg)}

  /* TABLE */
  .tbl-wrap{overflow-x:auto}
  table.tx{width:100%;border-collapse:separate;border-spacing:0;min-width:1020px}
  table.tx th{font-size:.74rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:600;text-align:left;padding:.75rem 1rem;border-bottom:1px solid var(--line);white-space:nowrap}
  table.tx th.sortable{cursor:pointer;user-select:none}
  table.tx th.sortable:hover{color:var(--teal-dark)}
  table.tx th .sar{opacity:.4;margin-left:.2rem}
  table.tx th.sorted .sar{opacity:1;color:var(--teal-dark)}
  table.tx td{padding:.8rem 1rem;border-bottom:1px solid var(--line-2);font-size:.88rem;color:var(--navy);vertical-align:middle}
  table.tx tbody tr{transition:.15s}
  table.tx tbody tr:hover{background:var(--cream)}
  .chk{width:17px;height:17px;accent-color:var(--teal-dark);cursor:pointer}

  .tour-cell{display:flex;align-items:center;gap:.7rem;min-width:220px}
  .tour-cell img{width:52px;height:52px;border-radius:11px;object-fit:cover;flex:none}
  .tour-cell b{font-family:'Sora';font-weight:600;font-size:.9rem;color:var(--navy);display:block;line-height:1.25}
  .tour-cell span{font-size:.78rem;color:var(--teal-dark);font-weight:500}
  .cat-pill{font-size:.76rem;color:var(--navy);background:var(--cream);border:1px solid var(--line);padding:.22rem .6rem;border-radius:999px;white-space:nowrap}
  .amount{font-family:'Sora';font-weight:600;white-space:nowrap}
  .muted-cell{color:var(--muted);white-space:nowrap}

  .cap{min-width:96px}
  .cap .cap-top{font-size:.84rem;font-weight:600;color:var(--navy);margin-bottom:.28rem}
  .cap .cap-top .full{color:var(--cancel-fg)}
  .cap-track{height:5px;background:var(--line-2);border-radius:999px;overflow:hidden}
  .cap-fill{height:100%;border-radius:999px;background:var(--teal)}
  .cap-fill.high{background:#e0a83d}
  .cap-fill.full{background:var(--cancel-fg)}

  .badge-x{font-size:.74rem;font-weight:600;padding:.28rem .7rem;border-radius:999px;white-space:nowrap;display:inline-flex;align-items:center;gap:.35rem}
  .badge-x::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
  .b-ok{background:var(--ok-bg);color:var(--ok-fg)}
  .b-pasif{background:var(--cancel-bg);color:var(--cancel-fg)}
  .b-taslak{background:var(--wait-bg);color:var(--wait-fg)}

  /* actions dropdown */
  .act-btn{width:34px;height:34px;border-radius:10px;background:#fff;border:1px solid var(--line);display:grid;place-items:center;color:var(--muted);cursor:pointer;transition:.2s}
  .act-btn:hover{border-color:var(--teal);color:var(--teal-dark)}
  .dropdown-menu{border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-md);padding:.4rem;font-size:.88rem;min-width:180px}
  .dropdown-item{border-radius:8px;padding:.5rem .7rem;font-weight:500;color:var(--navy);display:flex;align-items:center;gap:.6rem}
  .dropdown-item:hover{background:var(--cream);color:var(--teal-dark)}
  .dropdown-item svg{color:var(--muted)}
  .dropdown-item:hover svg{color:var(--teal-dark)}
  .dropdown-item.danger{color:var(--cancel-fg)}
  .dropdown-item.danger svg{color:var(--cancel-fg)}
  .dropdown-item.danger:hover{background:var(--cancel-bg)}

  /* pagination */
  .pager-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;padding:1rem 1.1rem}
  .pager{display:flex;gap:.35rem}
  .pager a{min-width:38px;height:38px;display:grid;place-items:center;border-radius:10px;background:#fff;border:1px solid var(--line);color:var(--navy);font-weight:600;font-size:.88rem;transition:.2s;padding:0 .3rem}
  .pager a:hover{border-color:var(--teal);color:var(--teal-dark)}
  .pager a.active{background:var(--navy);color:#fff;border-color:var(--navy)}
  .pager a.disabled{opacity:.45;pointer-events:none}
  .per-page{display:flex;align-items:center;gap:.5rem;font-size:.85rem;color:var(--muted)}
  .per-page select{border:1px solid var(--line);border-radius:9px;padding:.35rem 1.6rem .35rem .6rem;font-size:.85rem;font-weight:600;color:var(--navy);outline:none;cursor:pointer}

  /* empty */
  .empty{text-align:center;padding:3.5rem 1rem}
  .empty .eic{width:60px;height:60px;border-radius:16px;background:rgba(15,163,163,.1);color:var(--teal-dark);display:grid;place-items:center;margin:0 auto 1rem}
  .empty h3{font-family:'Sora';font-weight:700;color:var(--navy);font-size:1.2rem}
  .empty p{color:var(--muted);margin:.3rem 0 1.2rem}

  .admin-foot{padding:1.1rem 1.8rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:.82rem;color:var(--muted)}
  .sb-overlay{display:none;position:fixed;inset:0;background:rgba(14,42,59,.45);z-index:1044}
  .sb-overlay.show{display:block}

  .modal-content{border-radius:var(--r);border:none}

  @@media(max-width:1100px){
    .sidebar{transform:translateX(-100%);transition:transform .3s ease}
    .sidebar.show{transform:none}
    .main{margin-left:0}
    .hamb{display:grid}
  }
  @@media(max-width:575px){
    .content{padding:1.1rem}
    .tb-search{display:none}
    .tb-user .nm{display:none}
    .topbar{padding:.8rem 1rem}
  }
</style>
</head>