<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>

    function toggleSidebar(show) {
        document.getElementById("sidebar").classList.toggle("show", show);
        document.getElementById("sbOverlay").classList.toggle("show", show);
    }

    document.addEventListener("DOMContentLoaded", function() {
        const searchInput = document.getElementById("fSearch");
        const destSelect = document.getElementById("fDest");
        const catSelect = document.getElementById("fCat");
        const statusSelect = document.getElementById("fStatus");

        function filterTours() {
            const q = searchInput ? searchInput.value.trim().toLowerCase() : "";
            const dest = destSelect ? destSelect.value.trim().toLowerCase() : "";
            const cat = catSelect ? catSelect.value.trim().toLowerCase() : "";
            const st = statusSelect ? statusSelect.value.trim() : "";

            const rows = document.querySelectorAll("#tourRows tr");
            let visibleCount = 0;

            rows.forEach(row => {
                const title = (row.getAttribute("data-title") || "").toLowerCase();
                const destination = (row.getAttribute("data-destination") || "").toLowerCase();
                const category = (row.getAttribute("data-category") || "").toLowerCase();
                const status = (row.getAttribute("data-status") || "").trim();

                let matches = true;

                if (q && !title.includes(q)) {
                    matches = false;
                }

                if (dest && !destination.includes(dest)) {
                    matches = false;
                }

                if (cat && category !== cat) {
                    matches = false;
                }

                if (st && status !== st) {
                    matches = false;
                }

                if (matches) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            });

            const countEl = document.getElementById("resultCount");
            if (countEl) countEl.textContent = visibleCount;

            const emptyState = document.getElementById("emptyState");
            const pagerRow = document.getElementById("pagerRow");
            if (emptyState) emptyState.style.display = visibleCount === 0 ? "block" : "none";
            if (pagerRow) pagerRow.style.display = visibleCount === 0 ? "none" : "flex";
        }


        if (searchInput) searchInput.addEventListener("input", filterTours);
        if (destSelect) destSelect.addEventListener("change", filterTours);
        if (catSelect) catSelect.addEventListener("change", filterTours);
        if (statusSelect) statusSelect.addEventListener("change", filterTours);


        window.clearFilters = function() {
            if (searchInput) searchInput.value = "";
            if (destSelect) destSelect.value = "";
            if (catSelect) catSelect.value = "";
            if (statusSelect) statusSelect.value = "";
            filterTours();
        };
    });

    let sortKey = null, sortDir = 1;
    const fmt = n => n.toLocaleString("tr-TR");
    const statusClass = { Aktif: "b-ok", Pasif: "b-pasif", Taslak: "b-taslak" };

    function getFiltered() {
        const q = document.getElementById("fSearch").value.trim().toLowerCase();
        const dest = document.getElementById("fDest").value;
        const cat = document.getElementById("fCat").value;
        const st = document.getElementById("fStatus").value;
        let list = TOURS.filter(t => {
            if (q && !(t.title.toLowerCase().includes(q) || t.country.toLowerCase().includes(q))) return false;
            if (dest && !t.country.includes(dest)) return false;
            if (cat && t.cat !== cat) return false;
            if (st && t.status !== st) return false;
            return true;
        });
        if (sortKey) {
            list.sort((a, b) => {
                let av, bv;
                if (sortKey === "title") { av = a.title; bv = b.title; return av.localeCompare(bv, "tr") * sortDir; }
                if (sortKey === "price") { av = a.price; bv = b.price; }
                if (sortKey === "res") { av = a.res; bv = b.res; }
                if (sortKey === "date") { av = a.ds; bv = b.ds; return av.localeCompare(bv) * sortDir; }
                return (av - bv) * sortDir;
            });
        }
        return list;
    }

    function capClass(res, cap) {
        const p = cap ? res / cap : 0;
        if (res >= cap && cap > 0) return "full";
        if (p >= .85) return "high";
        return "";
    }

    function render() {
        const list = getFiltered();
        const tb = document.getElementById("tourRows");
        document.getElementById("resultCount").textContent = list.length;
        const empty = document.getElementById("emptyState");
        const pager = document.getElementById("pagerRow");

        if (list.length === 0) { tb.innerHTML = ""; empty.style.display = "block"; pager.style.display = "none"; updateBulk(); return; }
        empty.style.display = "none"; pager.style.display = "flex";

        tb.innerHTML = list.map(t => {
            const cc = capClass(t.res, t.cap);
            const pct = t.cap ? Math.min(100, Math.round(t.res / t.cap * 100)) : 0;
            return `
                                                                    <tr data-id="${t.id}">
                                                                      <td><input type="checkbox" class="chk row-chk" value="${t.id}" onchange="updateBulk()"></td>
                                                                      <td>
                                                                        <div class="tour-cell">
                                                                          <img src="${t.img}" alt="${t.title}">
                                                                          <div><b>${t.title}</b><span>${t.country}</span></div>
                                                                        </div>
                                                                      </td>
                                                                      <td><span class="cat-pill">${t.cat}</span></td>
                                                                      <td class="muted-cell">${t.dur}</td>
                                                                      <td><span class="amount">${fmt(t.price)} TL</span></td>
                                                                      <td class="muted-cell">${t.date}</td>
                                                                      <td>
                                                                        <div class="cap">
                                                                          <div class="cap-top">${t.res} / ${t.cap} ${cc === "full" ? '<span class="full">· Dolu</span>' : ''}</div>
                                                                          <div class="cap-track"><div class="cap-fill ${cc}" style="width:${pct}%"></div></div>
                                                                        </div>
                                                                      </td>
                                                                      <td style="font-weight:600">${t.res}</td>
                                                                      <td><span class="badge-x ${statusClass[t.status]}">${t.status}</span></td>
                                                                      <td>
                                                                        <div class="dropdown">
                                                                          <button class="act-btn" data-bs-toggle="dropdown" aria-label="İşlemler">
                                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="19" r="1.7"/></svg>
                                                                          </button>
                                                                          <ul class="dropdown-menu dropdown-menu-end">
                                                                            <li><a class="dropdown-item" href="tour-detail.html"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg> Görüntüle</a></li>
                                                                            <li><a class="dropdown-item" href="admin-tour-edit.html"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg> Düzenle</a></li>
                                                                            <li><a class="dropdown-item" href="#" onclick="copyTour(${t.id});return false"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Kopyala</a></li>
                                                                            <li><a class="dropdown-item" href="#" onclick="toggleStatus(${t.id});return false"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9"/><polyline points="21 3 21 9 15 9"/></svg> ${t.status === "Aktif" ? "Pasif Yap" : "Aktif Yap"}</a></li>
                                                                            <li><a class="dropdown-item danger" href="#" onclick="askDelete(${t.id});return false"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg> Sil</a></li>
                                                                          </ul>
                                                                        </div>
                                                                      </td>
                                                                    </tr>`;
        }).join("");
        document.getElementById("checkAll").checked = false;
        updateBulk();
    }

    /* sorting */
    function sortBy(key) {
        if (sortKey === key) sortDir *= -1; else { sortKey = key; sortDir = 1; }
        document.querySelectorAll("th.sortable").forEach(th => th.classList.remove("sorted"));
        event.currentTarget.classList.add("sorted");
        render();
    }

    /* filters */
    ["fSearch", "fDest", "fCat", "fStatus"].forEach(id => {
        document.getElementById(id).addEventListener("input", render);
        document.getElementById(id).addEventListener("change", render);
    });
    function clearFilters() {
        document.getElementById("fSearch").value = "";
        document.getElementById("fDest").value = "";
        document.getElementById("fCat").value = "";
        document.getElementById("fStatus").value = "";
        sortKey = null; sortDir = 1;
        document.querySelectorAll("th.sortable").forEach(th => th.classList.remove("sorted"));
        render();
    }

    /* status toggle */
    function toggleStatus(id) {
        const t = TOURS.find(x => x.id === id);
        t.status = t.status === "Aktif" ? "Pasif" : "Aktif";
        render();
    }
    function copyTour(id) {
        const t = TOURS.find(x => x.id === id);
        const copy = { ...t, id: Math.max(...TOURS.map(x => x.id)) + 1, title: t.title + " (Kopya)", res: 0, status: "Taslak" };
        TOURS.splice(TOURS.indexOf(t) + 1, 0, copy);
        render();
    }

    /* delete */
    let delId = null;
    function askDelete(id) {
        delId = id;
        const t = TOURS.find(x => x.id === id);
        document.getElementById("delMsg").innerHTML = `"<b style="color:var(--navy)">${t.title}</b>" turunu silmek istediğinize emin misiniz?`;
        new bootstrap.Modal(document.getElementById("delModal")).show();
    }
    function confirmDelete() {
        TOURS = TOURS.filter(x => x.id !== delId);
        bootstrap.Modal.getInstance(document.getElementById("delModal")).hide();
        render();
    }

    /* bulk */
    function toggleAll(cb) { document.querySelectorAll(".row-chk").forEach(c => c.checked = cb.checked); updateBulk(); }
    function selectedIds() { return [...document.querySelectorAll(".row-chk:checked")].map(c => +c.value); }
    function updateBulk() {
        const ids = selectedIds();
        const bar = document.getElementById("bulkBar");
        bar.classList.toggle("show", ids.length > 0);
        document.getElementById("bulkCount").textContent = ids.length + " tur seçildi";
    }
    function bulkStatus(st) { selectedIds().forEach(id => { TOURS.find(x => x.id === id).status = st; }); render(); }
    function bulkDelete() { const ids = selectedIds(); TOURS = TOURS.filter(x => !ids.includes(x.id)); render(); }


    function updateStatus(id, newStatus) {
        fetch('/Admin/Reservation/UpdateStatus', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: id, status: newStatus })
        })
            .then(r => {
                if (r.ok) {
                    location.reload();
                }
                else {
                    alert("Durum güncellenirken bir hata oluştu.");
                }
            })
            .catch(error => {
                console.error('Hata:', error);
                alert("Bağlantı hatası oluştu.");
            });
    }

    function openReservationDetail(id) {
        fetch(`/Admin/Reservation/GetReservationById?id=${id}`)
            .then(r => {
                if (!r.ok) { throw new Error("Veri alınamadı") };
                return r.json();
            })
            .then(data => {
                document.getElementById("modalResId").textContent = "TRV-" + data.id.substring(0, 8).toUpperCase();
                document.getElementById("modalUserFullName").textContent = data.userFullName;
                document.getElementById("modalUserEmail").textContent = data.userEmail;
                document.getElementById("modalTourName").textContent = data.tourName;
                document.getElementById("modalDestinationName").textContent = data.destinationName;

                let startDate = new Date(data.tourDate);
                let endDate = new Date(startDate);
                endDate.setDate(startDate.getDate() + data.duration);

                let options = { day: '2-digit', month: 'short', year: 'numeric' };
                document.getElementById("modalTourDateRange").textContent = startDate.toLocaleDateString('tr-TR', options) + " - " + endDate.toLocaleDateString('tr-TR', options);

                document.getElementById("modalDuration").textContent = data.duration + " Gün";
                document.getElementById("modalPeopleCount").textContent = `${data.adultCount} Yetişkin${data.childCount > 0 ? ', ' + data.childCount + ' Çocuk' : ''}`;
                document.getElementById("modalTotalPrice").textContent = data.totalPrice.toLocaleString("tr-TR", { minimumFractionDigits: 2 }) + " TL";

                let createdDate = new Date(data.createdAt);
                document.getElementById("modalCreatedAt").textContent = createdDate.toLocaleDateString("tr-TR", { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });

                new bootstrap.Modal(document.getElementById("reservationDetailModal")).show();

            })
            .catch(err => {
                console.error(err);
                alert("Rezervasyon detayları yüklenirken bir hata oluştu.");
            });
    }

    function openQuestionDetail(id) {
        fetch(`/Admin/Question/GetQuestionById?id=${id}`)
            .then(r => {
                if (!r.ok) { throw new Error("Veri alınamadı.") };
                return r.json();
            })
            .then(data => {
                document.getElementById("modalUserFullName").textContent = data.userFullName;
                document.getElementById("modalUserEmail").textContent = data.email;
                document.getElementById("modalTourName").textContent = data.tourName;
                document.getElementById("modalContent").textContent = data.content;

                const answerBox = document.getElementById("modalAnswerContent");
                if (data.isAnswered && data.answer) {
                    answerBox.textContent = data.answer;
                    answerBox.style.borderColor = "#198754";
                } else {
                    answerBox.textContent = "Bu soru henüz cevaplanmamış.";
                    answerBox.style.borderColor = "#ffc107";
                }


                let createdDate = new Date(data.createdAt);
                document.getElementById("modalCreatedAt").textContent = createdDate.toLocaleDateString("tr-TR", { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });

                new bootstrap.Modal(document.getElementById("reservationDetailModal")).show();

            })
            .catch(err => {
                console.error(err);
                alert("Soru detayı yüklenirken bir hata oluştu.");

            });
    }

    function openAnswerModal(id) {
        document.getElementById("answerQuestionId").value = id;
        document.getElementById("answerContent").value = "";

        new bootstrap.Modal(document.getElementById("answerModal")).show();
    }

    function submitAnswer() {
        const questionId = document.getElementById("answerQuestionId").value;
        const answer = document.getElementById("answerContent").value;

        if (!answer.trim()) {
            alert("Lütfen bir cevap yazın");
            return;
        }

        fetch('/Admin/Question/AnswerQuestion', {
            method: "POST",
            headers: { 'Content-Type': "application/x-www-form-urlencoded" },
            body: `questionId=${encodeURIComponent(questionId)}&answer=${encodeURIComponent(answer)}`
        })
            .then(r => {
                if (!r.ok) { throw new Error("Cevap kaydedilemedi."); }
                return r.json();
            })
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(err => {
                console.error(err);
                alert("İşlem sırasında bir hata oluştu");
            });
    }


    function loadReportDates() {
        const tourId = document.getElementById('reportTourId').value;
        const dateSelect = document.getElementById('reportDateId');

        if (!tourId) {
            dateSelect.innerHTML = '<option value="">Tüm Tarihler</option>';
            dateSelect.disabled = true;
            return;
        }

        fetch(`/Admin/Tour/GetTourDatesForReport?tourId=${tourId}`)
            .then(r => r.json())
            .then(data => {
                dateSelect.innerHTML = '<option value="">Tüm Tarihler</option>';
                data.forEach(d => {
                    dateSelect.innerHTML += `<option value="${d.id}">${d.date}</option>`;
                });
                dateSelect.disabled = false;
            });
    }

    function downloadTourReport(format) {
        const tourId = document.getElementById('reportTourId').value;
        const tourDateId = document.getElementById('reportDateId').value;
        const status = document.getElementById('reportStatus').value;

        if (!tourId) {
            alert('Lütfen bir tur seçin.');
            return;
        }

        let url;
        if (tourDateId) {
            const action = format === 'excel' ? 'DownloadTourDateExcelReport' : 'DownloadTourDatePdfReport';
            url = `/Admin/Tour/${action}?tourId=${tourId}&tourDateId=${tourDateId}`;
            if (status) url += `&status=${encodeURIComponent(status)}`;
        } else {
            const action = format === 'excel' ? 'DownloadExcelReport' : 'DownloadPdfReport';
            url = `/Admin/Tour/${action}?tourId=${tourId}`;
        }

        window.open(url, '_blank');
    }

    function approveComment(id) {
        fetch(`/Admin/Comment/Approve?commentId=${id}`, {
            method: "POST"
        })
            .then(r => {
                if (r.ok) location.reload();
            });
    }

    function spamComment(id) {
        fetch(`/Admin/Comment/MarkAsSpam?commentId=${id}`, {
            method: "POST"
        })
            .then(r => {
                if (r.ok) location.reload();
            });
    }

    function openCommentDetail(id, fullName, email, tourName, content, rating, createdAt) {
        document.getElementById('modalUserFullName').textContent = fullName;
        document.getElementById('modalUserEmail').textContent = email;
        document.getElementById('modalTourName').textContent = tourName;
        document.getElementById('modalContent').textContent = content;
        document.getElementById('modalAnswerContent').textContent = '⭐'.repeat(rating) + ' (' + rating + '/5)';
        document.getElementById('modalCreatedAt').textContent = createdAt;

        new bootstrap.Modal(document.getElementById("commentDetailModal")).show();
    }


  
    render();
</script>