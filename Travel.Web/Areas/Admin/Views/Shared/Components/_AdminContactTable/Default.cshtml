@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ResultContactDto>

@{
    ViewData["Title"] = "İletişim Mesajları";
    int count = (Model.PageNumber - 1) * Model.PageSize + 1;
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-header bg-white py-3 border-0" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
            <h5 class="fw-bold text-dark mb-0">İletişim Mesajları Yönetimi</h5>
        </div>
        <div class="card-body px-0 pb-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Gönderen</th>
                            <th>E-Posta</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">@count</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                    </td>
                                    <td class="text-muted">@item.Email</td>
                                    <td>
                                        <span class="text-dark fw-medium">@item.Subject</span>
                                    </td>
                                    <td class="text-muted small">@item.SendDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (item.IsRead)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2 py-1" style="border-radius: 6px;">Okundu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning px-2 py-1" style="border-radius: 6px;">Okunmadı</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            @if (!item.IsRead)
                                            {
                                                <a href="/Admin/Contact/MarkAsRead/@item.Id" class="btn btn-sm btn-outline-success" title="Okundu İşaretle" style="border-radius: 6px;">
                                                    ✓ Okundu Yap
                                                </a>
                                            }
                                            <a href="/Admin/Contact/DeleteContact/@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?');" title="Sil" style="border-radius: 6px;">
                                                🗑️ Sil
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Henüz hiç iletişim mesajı bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sayfalama (Pagination) Alanı -->
            @if (Model.PageCount > 1)
            {
                <div class="card-footer bg-white py-3 border-0 d-flex justify-content-center">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), new PagedListRenderOptions
                    {
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" },
                        ActiveLiElementClass = "active"
                    })
                </div>
            }
        </div>
    </div>
</div>