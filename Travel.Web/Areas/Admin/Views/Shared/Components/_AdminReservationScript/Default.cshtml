<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("fSearch");
    const dateInput = document.getElementById("fDate");
    const statusSelect = document.getElementById("fStatus");

    function filterReservations() {
        const q = searchInput ? searchInput.value.trim().toLowerCase() : "";
        const selectedDate = dateInput ? dateInput.value : "";
        const st = statusSelect ? statusSelect.value.trim().toLowerCase() : "";

            const rows = document.querySelectorAll("#tourRows tr");
        let visibleCount = 0;

        rows.forEach(row => {
            const tourName = (row.getAttribute("data-tour") || "").toLowerCase();
            const userName = (row.getAttribute("data-user") || "").toLowerCase();
            const rowDate = (row.getAttribute("data-date") || "").trim();
            const rowStatus = (row.getAttribute("data-status") || "").trim().toLowerCase();

            let matches = true;

            if (q && !(tourName.includes(q) || userName.includes(q))) {
                matches = false;
            }

            if (selectedDate) {
                if (!rowDate.includes(selectedDate) && !selectedDate.includes(rowDate)) {
                    matches = false;
                }
            }

                if (st && rowStatus !== st) {
                matches = false;
            }

            if (matches) {
                row.style.display = "";
                visibleCount++;
                } else {
                row.style.display = "none";
            }
        });

        const countEl = document.getElementById("resultCount");
            if (countEl) countEl.textContent = visibleCount;


        const emptyState = document.getElementById("emptyState");
        const pagerRow = document.getElementById("pagerRow");
        if (emptyState) emptyState.style.display = visibleCount === 0 ? "block" : "none";
        if (pagerRow) pagerRow.style.display = visibleCount === 0 ? "none" : "flex";
        }

        if (searchInput) searchInput.addEventListener("input", filterReservations);
        if (dateInput) dateInput.addEventListener("change", filterReservations);
        if (statusSelect) statusSelect.addEventListener("change", filterReservations);

        window.clearFilters = function() {
            if (searchInput) searchInput.value = "";
            if (dateInput) dateInput.value = "";
            if (statusSelect) statusSelect.value = "";
            filterReservations();
        };
    });
</script>