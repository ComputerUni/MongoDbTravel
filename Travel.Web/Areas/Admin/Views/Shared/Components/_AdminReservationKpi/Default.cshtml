@model ReservationKpiDto

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="kpi"><div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg></div><div><div class="num">@Model.TotalPrice.ToString("N2") TL</div><div class="lab">Toplam Ciro</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi"><div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></div><div><div class="num">@Model.TotalReservationCount</div><div class="lab">Toplam Rezervasyon</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi"><div class="ic gray"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="8" y1="12" x2="16" y2="12" /></svg></div><div><div class="num">@Model.ApprovedReservationCount</div><div class="lab">Onaylanan Rezervasyon</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi"><div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /></svg></div><div><div class="num">@Model.PendingReservationCount</div><div class="lab">Onay Bekleyen Rezervasyon</div></div></div></div>
</div>