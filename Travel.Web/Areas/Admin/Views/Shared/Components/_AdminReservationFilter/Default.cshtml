<div class="card-x filter-bar mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-lg-5 col-md-6">
            <div class="f-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" id="fSearch" placeholder="Tur adı veya kullanıcı ara...">
            </div>
        </div>
       <div class="col-lg-3 col-md-4">
            <input type="date" class="f-select" id="fDate">
        </div>

        <div class="col-lg-3 col-md-4">
            <select class="f-select" id="fStatus">
                <option value="">Tüm Durumlar</option>
                <option value="Onaylandı">Onaylandı</option>
                <option value="Bekliyor">Bekliyor</option>
                <option value="İptal">İptal Edildi</option>
            </select>
        </div>
        <div class="col-lg-1 col-md-2">
            <button class="btn-clear" onclick="clearFilters()">Temizle</button>
        </div>
    </div>
</div>
<div class="result-line"><b id="resultCount">@Model.Count</b> rezervasyon listeleniyor</div>

