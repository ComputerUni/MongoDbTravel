@using System.Security.Claims

@functions {
    string IsActive(string href)
    {
        var currentPath = Context.Request.Path;
        if (href == "/Admin/Dashboard/Index")
        {
            if (currentPath.Equals(href, StringComparison.OrdinalIgnoreCase))
                return "active";
        }
        else
        {
            if (currentPath.StartsWithSegments(href, StringComparison.OrdinalIgnoreCase))
                return "active";
        }
        return "";
    }
}

<aside class="sidebar" id="sidebar">
    <div class="sb-brand">
        <span class="dot"></span>
        <span class="txt"><b>Travelio</b><span>Admin Panel</span></span>
    </div>
    <nav class="sb-menu">
        <div class="sb-cap">Yönetim</div>

        <a class="sb-link @IsActive("/Admin/Dashboard/Index")" href="/Admin/Dashboard/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            Dashboard
        </a>

        <a class="sb-link @IsActive("/Admin/Tour/Index")" href="/Admin/Tour/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
            Turlar
            <span class="sb-badge">@ViewBag.tours</span>
        </a>

        <a class="sb-link @IsActive("/Admin/Reservation/Index")" href="/Admin/Reservation/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
            Rezervasyonlar
            <span class="sb-badge">@ViewBag.reservations</span>
        </a>

        <a class="sb-link @IsActive("/Admin/Comment/Index")" href="/Admin/Comment/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
            Yorumlar
            <span class="sb-badge">@ViewBag.comments</span>
        </a>

        <a class="sb-link @IsActive("/Admin/Question/Index")" href="/Admin/Question/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12" y2="17" /></svg>
            Sorular
            <span class="sb-badge">@ViewBag.questions</span>
        </a>

        <a class="sb-link @IsActive("/Admin/User/Index")" href="/Admin/User/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            Kullanıcılar
        </a>

        <div class="sb-cap">Katalog</div>

        <a class="sb-link @IsActive("/Admin/Category/Index")" href="/Admin/Category/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7" y2="7" /></svg>
            Kategoriler
        </a>

        <a class="sb-link @IsActive("/Admin/Destination/Index")" href="/Admin/Destination/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            Destinasyonlar
        </a>

        <div class="sb-cap">Site Yönetimi</div>

        <a class="sb-link @IsActive("/Admin/WhyUsItem/Index")" href="/Admin/WhyUsItem/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
            Neden Biz
        </a>

        <a class="sb-link @IsActive("/Admin/Contact/Index")" href="/Admin/Contact/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            İletişim Mesajları
            <span class="sb-badge">@ViewBag.contacts</span>
        </a>

        <div class="sb-cap">Diğer</div>

        <a class="sb-link" href="/User/Home/Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-9 9 9" /><path d="M9 21V9h6v12" /></svg>
            Siteye Dön
        </a>

        <a class="sb-link" href="/User/Account/Logout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
            Çıkış Yap
        </a>
    </nav>
    <div class="sb-foot">
        <div class="sb-user">
            <div class="av">@(User.FindFirstValue("FirstName")?[0])@(User.FindFirstValue("LastName")?[0])</div>
            <div><b>@User.FindFirstValue("FirstName") @User.FindFirstValue("LastName")</b><span>@(User.IsInRole("Admin") ? "Admin" : "Üye")</span></div>
        </div>
    </div>
</aside>
<div class="sb-overlay" id="sbOverlay" onclick="toggleSidebar(false)"></div>