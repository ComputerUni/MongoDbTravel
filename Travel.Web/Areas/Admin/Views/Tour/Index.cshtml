@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.TopbarTitle = "Tur Yönetimi";
}

@await Component.InvokeAsync("_AdminTourHead")


<div class="crumb"><a href="#">Dashboard</a> / <span class="cur">Turlar</span></div>
<div class="page-intro">
    <div>
        <h1>Tur Yönetimi</h1>
        <p>Travelio'daki tüm turları görüntüleyebilir, filtreleyebilir ve yönetebilirsiniz.</p>
    </div>
    <a href="/Admin/Tour/Create" class="btn-teal">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Yeni Tur Ekle
    </a>
</div>

<!-- RAPOR AL -->
<div class="sec" style="margin-bottom:1rem">
    <div class="row g-3 align-items-end">
        <div class="col-auto">
            <label class="form-label fw-semibold">Tur Seç</label>
            <select class="ctrl" id="reportTourId" onchange="loadReportDates()">
                <option value="">Tur seçiniz...</option>
                @foreach (var tour in Model.Tours)
                {
                    <option value="@tour.Id">@tour.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label fw-semibold">Tur Tarihi</label>
            <select class="ctrl" id="reportDateId" disabled>
                <option value="">Tüm Tarihler</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label fw-semibold">Rezervasyon Durumu</label>
            <select class="ctrl" id="reportStatus">
                <option value="">Tüm Durumlar</option>
                @foreach (var status in Enum.GetValues<ReservationStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="button" class="btn-teal" onclick="downloadTourReport('excel')">📊 Excel</button>
            <button type="button" class="btn-navy" onclick="downloadTourReport('pdf')">📄 PDF</button>
        </div>
    </div>
</div>

@await Component.InvokeAsync("_AdminTourKpi") 
@await Component.InvokeAsync("_AdminTourFilter")
@await Component.InvokeAsync("_AdminTourBulkBar")
@await Component.InvokeAsync("_AdminTourTable")
@await Component.InvokeAsync("_AdminTourDeleteModal")
@await Component.InvokeAsync("_AdminTourScript")
