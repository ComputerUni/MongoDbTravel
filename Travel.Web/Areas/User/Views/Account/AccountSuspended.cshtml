@{
    ViewData["Title"] = "Hesabınız Askıya Alındı";
    Layout = null; // Eğer harici bir layout kullanıyorsan burayı "_Layout" yapabilirsin
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TurkuazTravel</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            :root {
                --teal: #0d9488;
                --navy: #111827;
                --muted: #6b7280;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: #f8fafc;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
            }

            .suspended-card {
                background: #ffffff;
                border-radius: 16px;
                border: none;
                padding: 40px;
                max-width: 520px;
                width: 100%;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
                text-align: center;
            }

            .suspended-icon {
                font-size: 3.5rem;
                margin-bottom: 20px;
                background: rgba(225, 29, 72, 0.1);
                width: 80px;
                height: 80px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                color: #e11d48;
            }

            h1 {
                font-family: 'Sora', sans-serif;
                font-weight: 700;
                font-size: 1.5rem;
                color: var(--navy);
                margin-bottom: 12px;
            }

            p {
                color: var(--muted);
                font-size: 0.95rem;
                line-height: 1.6;
                margin-bottom: 24px;
            }

            .btn-teal {
                background-color: var(--teal);
                color: white;
                font-weight: 600;
                padding: 10px 20px;
                border-radius: 8px;
                text-decoration: none;
                transition: all 0.2s ease-in-out;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: none;
            }

                .btn-teal:hover {
                    background-color: #0b7f80;
                    color: white;
                }

            .btn-outline {
                background-color: transparent;
                color: var(--muted);
                font-weight: 500;
                padding: 10px 20px;
                border-radius: 8px;
                text-decoration: none;
                border: 1px solid #e5e7eb;
                transition: all 0.2s ease-in-out;
            }

                .btn-outline:hover {
                    background-color: #f3f4f6;
                    color: var(--navy);
                }

            .actions {
                display: flex;
                gap: 12px;
                justify-content: center;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="suspended-card mx-auto">
            <div class="suspended-icon">
                🔒
            </div>
            <h1>Hesabınız Askıya Alındı</h1>
            <p>
                Güvenlik önlemleri veya kullanım koşullarının ihlali sebebiyle hesabınız geçici olarak dondurulmuştur.
                Durum hakkında detaylı bilgi almak için bizimle iletişime geçebilirsiniz.
            </p>
            <div class="actions">
                <a href="/User/Home/Index" class="btn btn-teal">Ana Sayfaya Dön</a>
                <a href="/User/Account/Login" class="btn btn-outline">Giriş Sayfası</a>
            </div>
        </div>
    </div>

</body>
</html>