@model LoginDto

@{
    Layout = "_AuthLayout";
}

<div class="auth">
    <div class="auth-row">

        <!-- LEFT VISUAL -->
        <div class="auth-visual" style="background: linear-gradient(160deg,rgba(14,42,59,.72) 0%,rgba(14,42,59,.45) 45%,rgba(11,127,128,.6) 100%), url('https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1400&q=80') center/cover;">
            <a class="brand" href="/"><span class="dot"></span>Travelio</a>
            <div class="visual-body">
                <div class="eyebrow">Tekrar hoş geldin</div>
                <h1>Maceran Seni Bekliyor</h1>
                <p>Hesabına giriş yap, rezervasyonlarını takip et ve yeni turları keşfet.</p>
                <ul class="perks">
                    <li>
                        <span class="pc">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        </span>Rezervasyonlarını görüntüle
                    </li>
                    <li>
                        <span class="pc">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                        </span>Favori turlarına hızlı eriş
                    </li>
                    <li>
                        <span class="pc">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                        </span>Yorum ve sorularını yönet
                    </li>
                </ul>
            </div>
            <div class="visual-foot">© 2026 Travelio · Dünyayı keşfetmeye hazır ol.</div>
        </div>

        <!-- RIGHT FORM -->

        <div class="auth-form">
            <div class="form-top">
                <a class="back-link" href="/">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                    Ana Sayfaya Dön
                </a>
            </div>

            <div class="form-wrap">
                <div class="form-inner">
                    <a class="brand mb-4" href="/"><span class="dot"></span>Travelio</a>

                    <div class="eyebrow">Travelio'ya Hoş Geldin</div>
                    <h2>Giriş Yap</h2>
                    <p class="lead">Hesabına erişmek için bilgilerini gir.</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert-error">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                            <div>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    }

                    <form method="post" asp-action="Login" asp-controller="Account">
                        @Html.AntiForgeryToken()

                        <div class="field">
                            <label asp-for="Email">E-posta</label>
                            <div class="input-wrap">
                                <input asp-for="Email" type="email" placeholder="ornek@email.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger" style="font-size:.78rem"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Password">Şifre</label>
                            <div class="input-wrap">
                                <input asp-for="Password" type="password" id="passwordInput" placeholder="Şifrenizi girin" autocomplete="current-password" />
                                <button type="button" class="toggle-eye" id="toggleEye" aria-label="Şifreyi göster">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger" style="font-size:.78rem"></span>
                        </div>

                        <div class="remember-row">
                            <div class="remember">
                                <input type="checkbox" id="rememberMe" name="rememberMe" />
                                <label for="rememberMe">Beni hatırla</label>
                            </div>
                        </div>

                        <button type="submit" class="btn-teal btn-submit">Giriş Yap</button>
                    </form>

                    <div class="register-line">Hesabın yok mu? <a asp-action="Register" asp-controller="Account">Kayıt Ol</a></div>
                </div>
            </div>
        </div>

    </div>
</div>