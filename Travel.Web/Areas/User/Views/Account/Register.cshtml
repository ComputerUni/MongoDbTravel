@model RegisterDto

@{
    Layout = "_AuthLayout";
}

<div class="auth">
    <div class="auth-row">

        <!-- LEFT VISUAL -->
        <div class="auth-visual" style="background: linear-gradient(160deg,rgba(14,42,59,.72) 0%,rgba(14,42,59,.45) 45%,rgba(11,127,128,.6) 100%), url('https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1400&q=80') center/cover;">
            <a class="brand" href="index.html"><span class="dot"></span>Travelio</a>
            <div class="visual-body">
                <div class="eyebrow">Travelio topluluğuna katıl</div>
                <h1>Yeni Maceraların Burada Başlıyor</h1>
                <p>Travelio hesabını oluştur, favori rotalarını kaydet, turlarını yönet ve seyahat deneyimlerini paylaş.</p>
                <ul class="perks">
                    <li><span class="pc"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg></span>Favori turlarını kaydet</li>
                    <li><span class="pc"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg></span>Rezervasyonlarını tek yerden yönet</li>
                    <li><span class="pc"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg></span>Yorum ve değerlendirmelerini paylaş</li>
                </ul>
            </div>
            <div class="visual-foot">© 2026 Travelio · Dünyayı keşfetmeye hazır ol.</div>
        </div>

        <!-- RIGHT FORM -->
        <div class="auth-form">
            <div class="form-top">
                <a class="back-link" href="/Account/Index">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                    Hesabınız var mı? Giriş Yapın.
                </a>
            </div>

            <div class="form-wrap">
                <div class="form-inner">
                    <a class="brand mb-4" href="index.html"><span class="dot"></span>Travelio</a>

                    <!-- FORM VIEW -->
                    <form method="post">
                        <div id="formView">
                            <div class="eyebrow">Travelio'ya Hoş Geldin</div>
                            <h2>Hesabını Oluştur</h2>
                            <p class="lead">Seyahatlerini planlamak ve yönetmek için birkaç bilgi yeterli.</p>
                            <div class="field" style="flex:1">
                                <label for="firstName">Kullanıcı Adı</label>
                                <div class="input-wrap"><input type="text" asp-for="UserName" placeholder="Kullanıcı Adınız" autocomplete="given-name"></div>
                                <div class="err-msg" id="err-firstName">Lütfen adını gir.</div>
                            </div>
                            <div class="row g-0" style="gap:0 .8rem;flex-wrap:nowrap">

                                <div class="field" style="flex:1">
                                    <label for="firstName">Ad</label>
                                    <div class="input-wrap"><input type="text" asp-for="FirstName" placeholder="Adınız" autocomplete="given-name"></div>
                                    <div class="err-msg" id="err-firstName">Lütfen adını gir.</div>
                                </div>
                                <div class="field" style="flex:1">
                                    <label for="lastName">Soyad</label>
                                    <div class="input-wrap"><input type="text" asp-for="LastName" placeholder="Soyadınız" autocomplete="family-name"></div>
                                    <div class="err-msg" id="err-lastName">Lütfen soyadını gir.</div>
                                </div>
                            </div>

                            <div class="field">
                                <label for="email">E-posta</label>
                                <div class="input-wrap"><input type="email" asp-for="Email" placeholder="ornek@email.com" autocomplete="email"></div>
                                <div class="err-msg" id="err-email">Geçerli bir e-posta adresi gir.</div>
                            </div>

                            <div class="field">
                                <label for="phone">Telefon</label>
                                <div class="input-wrap"><input type="tel" asp-for="PhoneNumber" placeholder="+90 5XX XXX XX XX" autocomplete="tel"></div>
                                <div class="err-msg" id="err-phone">Lütfen telefon numaranı gir.</div>
                            </div>

                            <div class="field">
                                <label for="password">Şifre</label>
                                <div class="input-wrap">
                                    <input type="password" asp-for="Password" placeholder="Şifrenizi oluşturun" autocomplete="new-password">
                                    <button type="button" class="toggle-eye" data-target="password" aria-label="Şifreyi göster">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                                    </button>
                                </div>
                                <div class="strength" id="strengthWrap" style="display:none">
                                    <div class="strength-bars"><i></i><i></i><i></i></div>
                                    <span class="strength-label" id="strengthLabel"></span>
                                </div>
                                <div class="hint">En az 8 karakter, bir büyük harf ve bir rakam kullan.</div>
                                <div class="err-msg" id="err-password">Şifren en az 8 karakter, bir büyük harf ve bir rakam içermeli.</div>
                            </div>

                            <div class="field">
                                <label for="password2">Şifre Tekrar</label>
                                <div class="input-wrap">
                                    <input type="password" asp-for="ConfirmPassword" placeholder="Şifrenizi tekrar girin" autocomplete="new-password">
                                    <button type="button" class="toggle-eye" data-target="password2" aria-label="Şifreyi göster">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                                    </button>
                                </div>
                                <div class="err-msg" id="err-password2">Şifreler eşleşmiyor.</div>
                            </div>

                         

                            <button class="btn-teal btn-submit" onclick="submitForm()">Hesap Oluştur</button>

                            <div class="login-line">Zaten hesabın var mı? <a href="/Account/Login">Giriş Yap</a></div>
                        </div>

                    </form>

                    <!-- SUCCESS VIEW -->
                    <div id="successView" style="display:none">
                        <div class="success-state">
                            <div class="sc">
                                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                            </div>
                            <h2>Hesabın başarıyla oluşturuldu.</h2>
                            <p>Travelio'ya hoş geldin, <b id="successName">gezgin</b>!</p>
                            <div class="redir"><span class="spinner"></span> Profiline yönlendiriliyorsun...</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>