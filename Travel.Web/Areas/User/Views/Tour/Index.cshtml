@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ResultTourDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<Travel.Web.SharedResource> L

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_TourListHead")

<body>

    <!-- NAV -->
    @await Component.InvokeAsync("_TourListNavbar")

    <!-- PAGE HEADER -->
    @await Component.InvokeAsync("_TourListHeader")

    <!-- LISTING -->
    <section class="listing">
        <div class="container">
            <div class="row g-4">

                <!-- SIDEBAR (desktop) -->
                <div class="col-lg-3 d-none d-lg-block">
                    <div class="sticky-side">
                        <div class="filter-card" id="filterCardDesktop"></div>
                    </div>
                </div>

                <!-- RESULTS -->
                <div class="col-lg-9">
                    <!-- toolbar -->
                    <div class="toolbar">
                        <div>
                            <h2>@L["Turlar"]</h2>
                            <div class="count"><span id="resultCount">@Model.Count</span> @L["turbulundu"]</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn-filter-mobile d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
                                @L["Filtrele"]
                            </button>
                            <div class="sort-wrap">
                                <label for="sortSelect" class="d-none d-sm-block">@L["Sirala"]:</label>
                                <select id="sortSelect">
                                    <option value="onerilen">@L["Onerilen"]</option>
                                    <option value="puan">@L["EnYuksekPuan"]</option>
                                    <option value="fiyat-artan">@L["Fiyat"]: @L["DusuktenYuksege"]</option>
                                    <option value="fiyat-azalan">@L["Fiyat"]: @L["YuksektenDusuge"]</option>
                                    <option value="yeni">@L["EnYeniTurlar"]</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- active chips -->
                    <div class="active-chips" id="activeChips"></div>

                    <div class="row g-4" id="tourGrid"></div>
                    <!-- grid -->
                    <!-- empty -->
                    <div id="emptyState" style="display:none">
                        <div class="empty-state">
                            <div class="ico">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                            </div>
                            <h3>@L["AradiginKriter"]</h3>
                            <p>@L["FiltreGevsetme"]</p>
                            <button class="btn-teal" onclick="clearFilters()">@L["FiltreleriTemizle"]</button>
                        </div>
                    </div>

                    <div class="pager-row" id="pagerRow">

                        <div class="pager">
                            @Html.PagedListPager(Model, page => Url.Action("Index", "Tour", new { area = "User", page }), new PagedListRenderOptions
                            {
                                LiElementClasses = new[] { "page-item" },
                                PageClasses = new[] { "page-link" },
                                DisplayLinkToFirstPage = PagedListDisplayMode.Never,
                                DisplayLinkToLastPage = PagedListDisplayMode.Never,
                                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                            })
                        </div>
                    </div>

                    <!-- mini cta -->
                    <div class="mini-cta">
                        <div class="eyebrow">@L["YardimciOlalim"]</div>
                        <h2>@L["AradiginRota"]</h2>
                        <p>@L["CTAAciklama"]</p>
                        <a href="/User/Contact/Index" class="btn-teal">@L["BizeUlas"]</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- OFFCANVAS FILTERS (mobile) -->
    @await Component.InvokeAsync("_TourListOffcanvas")

    <!-- FOOTER -->
    @await Component.InvokeAsync("_TourListFooter")

    @await Component.InvokeAsync("_TourListScript", Model)

</body>
</html>
