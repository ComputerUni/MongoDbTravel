@model ProfileViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Travel.Web.SharedResource> L


@{

    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEnglish = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);
    var cultureInfo = new System.Globalization.CultureInfo(isEnglish ? "en-US" : "tr-TR");

    var upcomingCount = Model.Reservations.Count(r => r.TourDate.ToLocalTime() >= DateTime.Now);
    var completedCount = Model.Reservations.Count(r => r.TourDate.ToLocalTime() < DateTime.Now);
    var favoriteCount = Model.Favorites.Count();
    var reviewCount = Model.Comments.Count();

    // var reservationData = Model.Reservations.Select(r => new
    // {
    //     tourName = displayTourName,
    //     destinationName = r.DestinationName,
    //     date = r.TourDate.ToLocalTime().ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR")),
    //     createdAt = r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR")),
    //     adultCount = r.AdultCount,
    //     childCount = r.ChildCount,
    //     id = "TRV-" + r.Id.Substring(0, 8).ToUpper(),
    //     status = r.Status switch
    //     {
    //         ReservationStatus.Onaylandı => "Onaylandı",
    //         ReservationStatus.İptal => "İptal Edildi",
    //         ReservationStatus.Bekliyor => "Bekliyor"
    //     },
    //     coverImage = r.CoverImage,
    //     tourDate = r.TourDate,
    //     tourId = r.TourId,
    //     tourIsActive = r.TourIsActive,
    //     reservationId = r.Id
    // }).ToList();


    var favoritesData = Model.Favorites.Select(f => new
    {
        title = f.TourName,
        country = f.Country,
        dur = f.Duration,
        rating = f.AverageRating,
        price = f.Price.ToString("N0", new System.Globalization.CultureInfo("tr-TR")),
        img = f.CoverImage,
        tourId = f.TourId
    }).ToList();


    var commentsData = Model.Comments.Select(c => new
    {
        id = c.Id,
        text = c.Content,
        title = c.TourName,
        stars = c.Rating,
        date = c.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy", cultureInfo),
    }).ToList();

    var ratingsData = Model.Comments.Select(c => new
    {
        id = c.Id,
        country = c.Country ?? "Destinasyon",
        title = c.TourName,
        stars = c.Rating,
        date = c.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy", cultureInfo),
    }).ToList();



    var questionsData = Model.Questions.Select(q => new
    {
        id = q.Id,
        tour = q.TourName,
        content = q.Content,
        date = q.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy", cultureInfo),
        status = q.IsAnswered ? "answered" : "waiting",
        answer = q.Answer ?? ""
    }).ToList();

}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    /* =============== ICONS =============== */
    const IC = {
        overview: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
        profile: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>',
        trips: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>',
        fav: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>',
        reviews: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
        questions: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12" y2="17"/></svg>',
        ratings: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 8.5 22 9.3 17 14 18.2 21 12 17.6 5.8 21 7 14 2 9.3 9 8.5 12 2"/></svg>',
        logout: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>'
    };
    const MENU = [
        { id: "overview", label: "@L["GenelBakis"]", ic: "overview" },
        { id: "profile", label: "@L["ProfilBilgi"]", ic: "profile" },
        { id: "trips", label: "@L["Rezervasyonlarim"]", ic: "trips" },
        { id: "favorites", label: "@L["Favorilerim"]", ic: "fav" },
        { id: "reviews", label: "@L["Yorumlarim"]", ic: "reviews" },
        { id: "questions", label: "@L["Sorularim"]", ic: "questions" },
        { id: "ratings", label: "@L["Degerlendirmelerim"]", ic: "ratings" }
    ];

    /* =============== DATA =============== */
    // const IMG = {
    //     prag: "https://images.unsplash.com/photo-1541849546-216549ae216d?auto=format&fit=crop&w=800&q=80",
    //     norway: "https://images.unsplash.com/photo-1483347756197-71ef80e95f73?auto=format&fit=crop&w=800&q=80",
    //     roma: "https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=800&q=80",
    //     paris: "https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=800&q=80",
    //     amsterdam: "https://images.unsplash.com/photo-1534351590666-13e3e96b5017?auto=format&fit=crop&w=800&q=80",
    //     tokyo: "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=800&q=80",
    //     swiss: "https://images.unsplash.com/photo-1531366936337-7c912a4589a7?auto=format&fit=crop&w=800&q=80",
    //     alsace: "https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=800&q=80"
    // };

    
    let FAVORITES = @Html.Raw(Json.Serialize(favoritesData));

    // let FAVORITES = [
    //     { title: "Tokyo & Kyoto", country: "Japonya", dur: "8 Gün / 7 Gece", rating: 4.8, price: "79.900", img: IMG.tokyo },
    //     { title: "İsviçre Alpleri", country: "İsviçre", dur: "7 Gün / 6 Gece", rating: 5.0, price: "58.200", img: IMG.swiss },
    //     { title: "Kuzey Işıkları Norveç", country: "Norveç", dur: "6 Gün / 5 Gece", rating: 4.9, price: "64.900", img: IMG.norway },
    //     { title: "Paris & Alsace", country: "Fransa", dur: "7 Gün / 6 Gece", rating: 4.8, price: "47.900", img: IMG.alsace }
    // ];

    let MYREVIEWS = @Html.Raw(Json.Serialize(commentsData));
    // let MYREVIEWS = [
    //     { id: 1, title: "Roma & Toskana Keşfi", stars: 5, date: "12 Haziran 2026", text: "Roma zaten çok güzeldi ama Toskana bölümü turun en unutulmaz kısmıydı. Rehberimiz de çok ilgiliydi." },
    //     { id: 2, title: "Paris & Disneyland", stars: 5, date: "18 Mart 2026", text: "İlk Paris seyahatimizdi ve organizasyon gerçekten çok başarılıydı." },
    //     { id: 3, title: "Amsterdam Kanalları", stars: 4, date: "16 Kasım 2025", text: "Tur çok güzeldi, yalnızca serbest zaman biraz daha uzun olabilirdi." }
    // ];


    const rawReservations = @Html.Raw(Json.Serialize(ViewBag.ReservationDatas));
    const now = new Date();

    const TRIPS = {
        upcoming: rawReservations
            .filter(r => new Date(r.tourDate) >= now)
            .map(r => ({
                title: r.tourName || "",
                country: r.destinationName || "",
                date: r.date,
                createdAt: r.createdAt,
                adultCount: r.adultCount,
                childCount: r.childCount,
                res: r.id || "",
                status: r.status,
                img: r.coverImage,
                tourId: r.tourId,
                tourIsActive: r.tourIsActive,
                reservationId: r.reservationId,
                tourDate: r.tourDate
            })),

        completed: rawReservations
            .filter(r => new Date(r.tourDate)
                < now)
            .map(r => ({
                title: r.tourName || "",
                country: r.destinationName || "",
                date: r.date,
                createdAt: r.createdAt,
                adultCount: r.adultCount,
                childCount: r.childCount,
                res: r.id || "",
                status: r.status,
                img: r.coverImage,
                tourId: r.tourId,
                tourIsActive: r.tourIsActive,
                reservationId: r.reservationId,
                tourDate: r.tourDate
            }))
    };

    let QUESTIONS = @Html.Raw(Json.Serialize(questionsData));

    // const QUESTIONS = [
    //     { tour: "Roma & Toskana Keşfi", q: "Vatikan giriş bileti tur ücretine dahil mi?", date: "3 Haziran 2026", status: "answered", a: "Vatikan müzeleri giriş ücretleri tur paketine dahil değildir." },
    //     { tour: "Kuzey Işıkları Norveç", q: "Termal kıyafet sağlanıyor mu?", date: "28 Temmuz 2026", status: "waiting" },
    //     { tour: "Tokyo & Kyoto", q: "Tur sırasında hızlı tren kullanılıyor mu?", date: "15 Temmuz 2026", status: "answered", a: "Evet. Tokyo - Kyoto geçişinde Shinkansen hızlı treni kullanılmaktadır." }
    // ];


    let RATINGS = @Html.Raw(Json.Serialize(ratingsData));

    // let RATINGS = [
    //     { title: "Roma & Toskana Keşfi", country: "İtalya", stars: 5, date: "12 Haziran 2026" },
    //     { title: "Paris & Disneyland", country: "Fransa", stars: 5, date: "18 Mart 2026" },
    //     { title: "Amsterdam Kanalları", country: "Hollanda", stars: 4, date: "16 Kasım 2025" },
    //     { title: "Prag Noel Pazarları", country: "Çekya", stars: 5, date: "22 Aralık 2025" }
    // ];

    /* =============== HELPERS =============== */
    function starStr(n) { let s = ""; for (let i = 1; i <= 5; i++) s += i <= n ? "★" : "<span class='off'>★</span>"; return s; }
    function toast(msg) { const t = document.getElementById("toast"); document.getElementById("toastMsg").textContent = msg; t.classList.add("show"); setTimeout(() => t.classList.remove("show"), 2600); }

    /* =============== SIDEBAR =============== */
    function sidebarHTML() {
        return `
                                                                                          <div class="side-user">
                                                                                            <div class="av">@Model.User.FirstName[0]@Model.User.LastName[0]</div>
                                                                                            <div style="min-width:0"><b>@Model.User.FirstName @Model.User.LastName</b><span>@Model.User.Email</span></div>
                                                                                          </div>
                                                                                          <div class="side-menu">
                                                                                            ${MENU.map(m => `<button class="side-link" data-pane="${m.id}" onclick="go('${m.id}')">${IC[m.ic]} ${m.label}</button>`).join("")}
                                                                                            <div class="side-sep"></div>
                                                                                                <button class="side-link logout" data-bs-toggle="modal" data-bs-target="#logoutModal">${IC.logout} @L["Cikis"]</button>
                                                                                          </div>`;
    }
    document.getElementById("sidebarDesktop").innerHTML = sidebarHTML();
    document.getElementById("sidebarMobile").innerHTML = sidebarHTML();

    /* =============== NAVIGATION =============== */
    let current = "overview";
    function go(id) {
        current = id;
        document.querySelectorAll(".side-link[data-pane]").forEach(b => b.classList.toggle("active", b.dataset.pane === id));
        document.getElementById("contentArea").innerHTML = RENDER[id]();
        const oc = document.getElementById("accountMenu");
        const inst = bootstrap.Offcanvas.getInstance(oc);
        if (inst) inst.hide();
        window.scrollTo({ top: 0, behavior: "smooth" });
        if (id === "ratings") bindRatingButtons();
    }

    /* =============== RENDERERS =============== */
    const RENDER = {
        overview() {
            const stats = [
                { ic: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>', num: @upcomingCount, lab: "@L["YaklasanTur"]" },
                { ic: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>', num: @completedCount, lab: "@L["Tamamlanan"]" },
                { ic: IC.fav, num: @favoriteCount, lab: "@L["Tamamlanan"]" },
                { ic: IC.reviews, num: @reviewCount, lab: "@L["Yorum"]" }
            ];
            const t = TRIPS.upcoming.find(r => r.tourIsActive === "Aktif" && r.status === "Onaylandı") || TRIPS.upcoming.find(r => r.tourIsActive === "Aktif") || null;
            const tourDate = t ? new Date(t.tourDate) : null;
            const remainingDays = tourDate && !isNaN(tourDate)
                ? Math.ceil((tourDate - now) / (1000 * 60 * 60 * 24))
                : 0;

            console.log(TRIPS.upcoming[0]?.tourDate);
            console.log(rawReservations);

            const isTourPassive = t && t.tourIsActive !== "Aktif";

            return `
                                                                                            <div class="pane active">
                                                                                              <div class="pane-head">
                                                                                                    <h1>@L["Merhaba"] @Model.User.FirstName 👋</h1>
                                                                                                    <p>@L["BirSonraki"]</p>
                                                                                              </div>
                                                                                              <div class="row g-3 mb-4">
                                                                                                ${stats.map(s => `<div class="col-6 col-md-3"><div class="stat-card"><div class="ico">${s.ic}</div><div class="num">${s.num}</div><div class="lab">${s.lab}</div></div></div>`).join("")}
                                                                                              </div>
      ${t ? `
                <div class="upcoming mb-4">
                    <img src="${t.img}" alt="${t.title}">
                    <div class="inner">
                            <span class="up-badge">@L["Rezervasyon"] ${t.res}</span>
                        <h3>${t.title}</h3>
                        <div class="sub">${t.country}</div>
                        <div class="up-meta">
                            <span>📅 <b>${t.date}</b></span>
                                    <span>⌛ @L["Kalan"]: <b>${remainingDays} @L["gun"]</b></span>
                            <span class="status-chip status-ok">● ${t.status}</span>
                        </div>
                        <div class="up-btns d-flex gap-2 flex-wrap">
                            ${isTourPassive
                        ? `<span class="btn-white" style="opacity:0.5;pointer-events:none;cursor:not-allowed;background:#e9ecef;">@L["PasifTur"]</span>`
                        : `<a href="/User/Tour/Detail/${t.tourId}" class="btn-white">@L["TurDetay"]</a>`
                    }
                                <button class="btn-linewhite" onclick="go('trips')">@L["RezervasyonGor"]</button>
                        </div>
                    </div>
                </div>` : `
                <div class="card-soft mb-4" style="text-align:center;padding:2rem">
                        <p style="color:var(--muted)">@L["YaklasanRez"]</p>
                        <a href="/User/Tour/Index" class="btn-teal">@L["TurKesfet"]</a>
                </div>`}

            </div>`;
        },

        profile() {
            return `
                                                                                            <div class="pane active">
                                                                <div class="pane-head">
                                                                        <h1>@L["ProfilBilgilerim"]</h1>
                                                                    <p>@L["KisiselBilgi"]</p>
                                                                </div>
                                                                <div class="card-soft">
                                                                    <div class="row g-3">
                                                                            <div class="col-md-6 field"><label>@L["Ad"]</label><input id="profileFirstName" value="@Model.User.FirstName"></div>
                                                                            <div class="col-md-6 field"><label>@L["Soyad"]</label><input id="profileLastName" value="@Model.User.LastName"></div>
                                                                            <div class="col-md-6 field"><label>@L["EPosta"]</label><input type="email" value="@Model.User.Email"></div>
                                                                                <div class="col-md-6 field"><label>@L["Tel"]</label><input id="profilePhone" value="@Model.User.PhoneNumber"></div>
                                                                            <div class="col-md-6 field"><label>@L["Dogum"]</label><input id="profileBirthDate" type="date" value="@Model.User.BirthDate"></div>
                                                                            <div class="col-md-6 field"><label>@L["Sehir"]</label><input id="profileCity" value="@Model.User.City"></div>
                                                                            <div class="col-md-6 field"><label>@L["Ulke"]</label><input id="profileCountry" value="@Model.User.Country"></div>
                                                                    </div>
                                                                        <button class="btn-teal mt-4" onclick="updateProfile()">@L["BilgiGuncelle"]</button>
                                                                </div>
                                                            </div>`;
        },

        trips() {
            const card = (t) => {
                const isTourPassive = t.tourIsActive !== "Aktif";
                const canCancel = t.status === 'Bekliyor';
                let guestText = `${t.adultCount} @L["Yetiskin"]`;
                if (t.childCount > 0) {
                    guestText += `, ${t.childCount} @L["Cocuk"]`
                }
                return `<div class="trip-card">
                    <img src="${t.img}" alt="${t.title}">
                    <div class="trip-info">
                        <h4>${t.title}</h4>
                        <div class="meta"><span>📅 <b>@L["TurTarihi"]:</b> ${t.date}</span></div>
                        <div class="meta"><span>👥 <b>@L["Yolcular"]:</b> ${guestText}</span></div>
                        <div class="meta"><span>📥 <b>@L["RezTarih"]:</b> ${t.createdAt}</span></div>
                        <div class="resno">🔖 ${t.res}</div>
                    </div>
                    <div class="trip-right">
                            <span style="font-size:.74rem;font-weight:600;padding:.3rem .7rem;border-radius:999px;
                                background:${t.status === 'Onaylandı' || t.status === 'Confirmed' ? 'rgba(15,163,163,.12)' : t.status === 'İptal Edildi' || t.status === 'Cancelled' ? 'rgba(192,85,79,.12)' : 'rgba(214,158,46,.15)'};
                                color:${t.status === 'Onaylandı' || t.status === 'Confirmed' ? '#0f5132' : t.status === 'İptal Edildi' || t.status === 'Cancelled' ? '#c0554f' : '#a9741a'}">
                                ${t.status}
                        </span>
                        <div class="acts">
                            ${isTourPassive
                        ? '<span class="mini-btn" style="opacity:0.5;pointer-events:none;cursor:not-allowed;background:#e9ecef;">Tur Pasife Alındı</span>'
                        : `<a href="/User/Tour/Detail/${t.tourId}" class="mini-btn">@L["TurDetay"]</a>`
                    }
                            ${!isTourPassive && t.status === 'Tamamlandı' ? (t.reviewed ? '<button class="mini-btn" onclick="go(&quot;reviews&quot;)">Yorumunu Gör</button>' : '<button class="mini-btn solid" onclick="go(&quot;reviews&quot;)">Yorum Yap</button>') : ''}
                            ${canCancel ? `<button class="mini-btn" style="color:#c0554f;border-color:#c0554f" onclick="cancelReservation('${t.reservationId}')">@L["Iptal"]</button>` : ''}
                        </div>
                    </div>
                </div>`;
            };

            return `
                                                                    <div class="pane active">
                                                                      <div class="pane-head"><h1>@L["Rezervasyonlarim"]</h1><p>@L["Yaklasan"]</p></div>
                                                                      <div class="subtabs" role="tablist">
                                                                        <button class="subtab active" onclick="tripFilter(this,'all')">@L["Tum"]</button>
                                                                        <button class="subtab" onclick="tripFilter(this,'upcoming')">@L["Yaklas"]</button>
                                                                        <button class="subtab" onclick="tripFilter(this,'completed')">@L["Tamamla"]</button>
                                                                      </div>
                                                                      <div id="tripUpcoming">
                                                                        <h3 style="font-family:'Sora';font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.9rem">@L["Yaklas"]</h3>
                                                                        ${TRIPS.upcoming.map(card).join("")}
                                                                      </div>
                                                                      <div id="tripCompleted">
                                                                        <h3 style="font-family:'Sora';font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:1.6rem 0 .9rem">@L["Tamamla"]</h3>
                                                                        ${TRIPS.completed.map(card).join("")}
                                                                      </div>
                                                                    </div>`;
        },

        favorites() {
            if (FAVORITES.length === 0) {
                return `<div class="pane active"><div class="pane-head"><h1>@L["Favorilerim"]</h1><p>@L["DahaSonra"]</p></div>
                                                                                                <div class="card-soft"><div class="empty">
                                                                                                  <div class="ico">${IC.fav}</div><h3>@L["Henuz"]</h3><p>@L["YeniRota"]</p>
                                                                                                      <a href="/User/Tour/Index" class="btn-teal">@L["TurKesfet"]</a>
                                                                                                </div></div></div>`;
            }
            return `
                                                                                            <div class="pane active">
                                                                                              <div class="pane-head"><h1>@L["Favorilerim"]</h1><p>@L["DahaSonra"]</p></div>
                                                                                              <div class="row g-4" id="favGrid">
                                                                                                ${FAVORITES.map((t, i) => `
                                                                                                  <div class="col-sm-6 col-lg-4" data-fav="${i}">
                                                                                                    <article class="tour-card">
                                                                                                      <div class="tour-media">
                                                                                                        <img src="${t.img}" alt="${t.title}">
                                                                                                        <button class="fav" title="@L["Kaldir"]" onclick="removeFav(${i})">
                                                                                                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                                                                                                        </button>
                                                                                                      </div>
                                                                                                      <div class="tour-body">
                                                                                                        <div class="tour-country">${t.country}</div>
                                                                                                        <h3 class="tour-title">${t.title}</h3>
                                                                                                        <div class="tour-meta"><span>🗓️ ${t.dur} @L["gun"]</span><span><span style="color:#f4a92c">★</span> ${t.rating.toFixed(1)}</span></div>
                                                                                                        <div class="tour-foot">
                                                                                                          <div class="price"><small>@L["KisiBasi"]</small><b>${t.price} <span>TL</span></b></div>
                                                                                                              <a href="/User/Tour/Detail/${t.tourId}" class="btn-incele">@L["TuruIncele"]</a>
                                                                                                        </div>
                                                                                                      </div>
                                                                                                    </article>
                                                                                                  </div>`).join("")}
                                                                                              </div>
                                                                                            </div>`;
        },

        reviews() {
            if (MYREVIEWS.length === 0) {
                return `<div class="pane active"><div class="pane-head"><h1>@L["Yorumlarim"]</h1></div>
                                                                                                <div class="card-soft"><div class="empty"><div class="ico">${IC.reviews}</div><h3>@L["HenuzYorum"]</h3><p>Tamamladığın turlar hakkında deneyimini paylaşabilirsin.</p><button class="btn-teal" onclick="go('trips')">Turlarıma Git</button></div></div></div>`;
            }
            return `
                                                                                            <div class="pane active">
                                                                                              <div class="pane-head"><h1>@L["Yorumlarim"]</h1><p>@L["TurlarHakkinda"]</p></div>
                                                                                              <div id="reviewList">
                                                                                                ${MYREVIEWS.map(r => `
                                                                                                  <div class="rev-card" data-rev="${r.id}">
                                                                                                    <div class="top">
                                                                                                      <div><h4>${r.title}</h4><span class="rev-date">${r.date}</span></div>
                                                                                                      <span class="rev-stars">${starStr(r.stars)}</span>
                                                                                                    </div>
                                                                                                    <p>${r.text}</p>
                                                                                                    <div class="rev-acts">
                                                                                                    <button class="mini-btn" onclick="openEditReview('${r.id}', '${r.text.replace(/'/g, "\\'")}', ${r.stars})">@L["Duzenle"]</button>                                                                                      
                                                                                                    <button class="mini-btn" onclick="askDeleteReview('${r.id}')">@L["Sil"]</button>
                                                                                                    </div>
                                                                                                  </div>`).join("")}
                                                                                              </div>
                                                                                            </div>`;
        },

        questions() {
            return `
                                                                                            <div class="pane active">
                                                                                              <div class="pane-head"><h1>@L["Sorularim"]</h1><p>@L["HenuzYorum"]</p></div>
                                                                                              ${QUESTIONS.map(q => `
                                                                                                <div class="q-card">
                                                                                                  <div class="top">
                                                                                                    <div>
                                                                                                      <div class="tour-name">${q.tour}</div>
                                                                                                      <div class="q-txt">${q.content}</div>
                                                                                                      <div class="q-date">${q.date}</div>
                                                                                                    </div>
                                                                                                    <span class="badge-soft ${q.status === 'answered' ? 'badge-ok' : 'badge-wait'}">${q.status === 'answered' ? '@L["Cevaplandi"]' : '@L["CevapBekliyor"]'}</span>
                                                                                                  </div>
                                                                                                  ${q.status === 'answered'
                    ? `<div class="q-answer"><span class="who">Travelio</span><span class="txt">${q.answer}</span></div>`
                    : `<div class="q-wait-note">@L["Ekibimiz"]</div>`}
                                                                                                </div>`).join("")}
                                                                                            </div>`;
        },

        ratings() {
            return `
                                                                                            <div class="pane active">
                                                                                              <div class="pane-head"><h1>@L["Degerlendirmelerim"]</h1><p>@L["KatilTur"]</p></div>
                                                                                              <div class="row g-3" id="rateGrid">
                                                                                                ${RATINGS.map((r, i) => `
                                                                                                  <div class="col-sm-6 col-lg-4">
                                                                                                    <div class="rate-card">
                                                                                                      <div class="country">${r.country}</div>
                                                                                                      <h4>${r.title}</h4>
                                                                                                      <div class="stars" data-stars="${i}">${starStr(r.stars)}</div>
                                                                                                      <div class="score">${r.stars} / 5</div>
                                                                                                      <div class="date">${r.date}</div>
                                                                                                      <button class="mini-btn mt-3" data-rate="${i}">@L["DegerlendirmeGuncelle"]</button>
                                                                                                    </div>
                                                                                                  </div>`).join("")}
                                                                                              </div>
                                                                                            </div>`;
        }
    };

    /* =============== INTERACTIONS =============== */
    // trips filter
    function tripFilter(btn, type) {
        document.querySelectorAll(".subtab").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById("tripUpcoming").style.display = (type === "completed") ? "none" : "block";
        document.getElementById("tripCompleted").style.display = (type === "upcoming") ? "none" : "block";
    }

    // favorites
    function removeFav(i) {
        const tourId = FAVORITES[i].tourId;
        fetch("/User/Favorite/Delete", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ tourId: tourId })
        }).then(r => {
            if (r.ok) {
                FAVORITES.splice(i, 1);
                document.getElementById("contentArea").innerHTML = RENDER.favorites();
                toast("@L["FavoriKaldir"]");
            }
        });
    }

    // delete review
    let pendingDelId = null;
    function askDeleteReview(id) { pendingDelId = id; new bootstrap.Modal(document.getElementById("delModal")).show(); }
    function confirmDeleteReview() {
        if (!pendingDelId) return;

        fetch("/User/Comment/Delete/" + pendingDelId, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ commentId: pendingDelId })
        })
            .then(r => {
                if (r.ok) {
                    MYREVIEWS = MYREVIEWS.filter(r => r.id !== pendingDelId);
                    bootstrap.Modal.getInstance(document.getElementById("delModal")).hide();
                    document.getElementById("contentArea").innerHTML = RENDER.reviews();
                    toast("@L["YorumSilindi"]");
                } else {
                    toast("@L["Silinemedi"]");
                }
            })
            .catch(err => toast("@L["Baglanti"] " + err.message));


        
    }

    // ratings modal
    let rateIndex = null, ratePicked = 0;
    function bindRatingButtons() {
        document.querySelectorAll("[data-rate]").forEach(b => {
            b.addEventListener("click", () => {
                rateIndex = +b.dataset.rate;
                ratePicked = RATINGS[rateIndex].stars;
                document.getElementById("rateTourName").textContent = RATINGS[rateIndex].title;
                paintPicker();
                new bootstrap.Modal(document.getElementById("rateModal")).show();
            });
        });
    }
    function paintPicker() {
        document.querySelectorAll("#ratePicker .star-pick").forEach(s => s.classList.toggle("on", +s.dataset.v <= ratePicked));
    }
    document.querySelectorAll("#ratePicker .star-pick").forEach(s => {
        s.addEventListener("click", () => { ratePicked = +s.dataset.v; paintPicker(); });
    });

    function saveRating() {
        if (rateIndex === null) return;

        const commentId = RATINGS[rateIndex].id;
        const updatedStars = ratePicked;

        fetch("/User/Comment/UpdateRating", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ commentId: commentId, rating: updatedStars })
        })
            .then(r => {
                if (r.ok) {
                    RATINGS[rateIndex].stars = updatedStars;

                    const review = MYREVIEWS.find(m => m.id === commentId);
                    if (review) {
                        review.stars = updatedStars;
                    }

                    bootstrap.Modal.getInstance(document.getElementById("rateModal")).hide();
                    document.getElementById("contentArea").innerHTML = RENDER.ratings();
                    bindRatingButtons();
                    toast("@L["Guncellendi"]");

                } else {
                    toast("@L["Guncellenmedi"]");
                }
            })
            .catch(err => toast("@L["Baglanti"] " + err.message));

    }

    function doLogout() {
        bootstrap.Modal.getInstance(document.getElementById("logoutModal")).hide();
        window.location.href = "/User/Account/Logout";
    }

    function updateProfile() {
        const dto = {
            firstName: document.getElementById("profileFirstName").value,
            lastName: document.getElementById("profileLastName").value,
            phoneNumber: document.getElementById("profilePhone").value,
            city: document.getElementById("profileCity").value,
            country: document.getElementById("profileCountry").value,
            birthDate: document.getElementById("profileBirthDate").value
        }


        fetch("/User/Profile/Update", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        })
            .then(r => {
                if (r.ok) {
                    window.location.href = "/User/Profile/Index";
                } else {
                    return r.text().then(t => { throw new Error(t); });
                }
            })
            .catch(err => toast("@L["ProfilGuncellenmedi"] " + err.message));
    }


    let editCommentId = null;

    function openEditReview(id, text, stars) {
        editCommentId = id;
        document.getElementById('editReviewText').value = text;
        editStars = stars;
        document.querySelectorAll('#editStarPicker .star-pick').forEach(s => {
            s.classList.toggle('on', +s.dataset.v <= stars);
        });
        new bootstrap.Modal(document.getElementById('editReviewModal')).show();
    }

    let editStars = 0;

    function saveEditReview() {
        fetch('/User/Comment/Update', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ commentId: editCommentId, content: document.getElementById('editReviewText').value, rating: editStars })
        }).then(r => {
            if (r.ok) {
                const rev = MYREVIEWS.find(r => r.id === editCommentId);
                if (rev) { rev.text = document.getElementById('editReviewText').value; rev.stars = editStars; }
                bootstrap.Modal.getInstance(document.getElementById('editReviewModal')).hide();
                document.getElementById('contentArea').innerHTML = RENDER.reviews();
                toast('@L["YorumGuncellendi"]');
            }
        });
    }

    document.querySelectorAll('#editStarPicker .star-pick').forEach(s => {
        s.addEventListener('click', () => {
            editStars = +s.dataset.v;
            document.querySelectorAll('#editStarPicker .star-pick').forEach(x => x.classList.toggle('on', +x.dataset.v <= editStars));
        });
    });

    let pendingCancelId = null;

    function cancelReservation(reservationId) {
        pendingCancelId = reservationId;
        new bootstrap.Modal(document.getElementById("cancelReservationModal")).show();
    }

    function confirmCancelReservation() {
        if (!pendingCancelId) return;

        fetch('/User/Profile/Cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ Id: pendingCancelId })
        })
            .then(r => {
                if (r.ok) {
                    bootstrap.Modal.getInstance(document.getElementById("cancelReservationModal")).hide();
                    toast('@L["RezIptal"]');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    r.text().then(errText => console.error("Hata Detayı:", errText));
                    toast('@L["IptalIslemi"].');
                }
            })
            .catch(err => alert("@L["Baglanti"]" + err.message));
    }


    /* init */
    const hash = location.hash.replace("#", "");
    go(hash && RENDER[hash] ? hash : "overview");
</script>