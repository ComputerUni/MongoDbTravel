<section class="py-5" style="background-color: #f8fafc; min-height: 80vh; display: flex; align-items: center;">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <span class="badge bg-light text-primary px-3 py-2 mb-2 fw-semibold" style="border-radius: 20px;">Bize Ulaşın</span>
                <h2 class="fw-bold text-dark display-6">Sorularınız İçin Buradayız</h2>
                <p class="text-muted">Seyahat planlarınız, turlarımız veya merak ettiğiniz her konuda bizimle iletişime geçebilirsiniz.</p>
            </div>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-4">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px; flex: 1;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light text-primary p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 20px;">
                                📍
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Ofisimiz</h6>
                                <p class="text-muted small mb-0">Gaziantep, Türkiye</p>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px; flex: 1;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light text-primary p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 20px;">
                                ✉️
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">E-Posta Adresi</h6>
                                <p class="text-muted small mb-0">info@turkuaztravel.com</p>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px; flex: 1;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light text-primary p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 20px;">
                                📞
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Telefon Destek</h6>
                                <p class="text-muted small mb-0">+90 (342) 000 00 00</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 p-md-5 bg-white h-100" style="border-radius: 12px;">
                    <h4 class="fw-bold text-dark mb-4">Bize Mesaj Gönderin</h4>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 8px;">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }

                    <form asp-controller="Contact" asp-action="Index" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">Adınız Soyadınız</label>
                                <input type="text" name="Name" class="form-control shadow-none" placeholder="Adınız Soyadınız" required style="border-radius: 8px; padding: 12px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">E-Posta Adresiniz</label>
                                <input type="email" name="Email" class="form-control shadow-none" placeholder="ornek@mail.com" required style="border-radius: 8px; padding: 12px;" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted small fw-semibold">Konu Başlığı</label>
                                <input type="text" name="Subject" class="form-control shadow-none" placeholder="Mesajınızın konusu nedir?" required style="border-radius: 8px; padding: 12px;" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted small fw-semibold">Mesajınız</label>
                                <textarea name="Message" class="form-control shadow-none" rows="5" placeholder="Mesajınızı buraya yazabilirsiniz..." required style="border-radius: 8px; padding: 12px;"></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn w-100 py-3 fw-semibold text-white" style="border-radius: 8px; background-color: #0d9488; border-color: #0d9488;">Mesajı Gönder</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>