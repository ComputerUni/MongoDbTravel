@model TourDetailViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Travel.Web.SharedResource> L

<div class="col-lg-8">

    <!-- ABOUT -->
    <div class="content-block">
        <h2>@L["TurHakkinda"]</h2>
        <p>@Model.Tour.Description</p>
        <p>@Model.Tour.ShortDescription</p>
    </div>

    <!-- HIGHLIGHTS -->
    <div class="content-block">
        <h2>@L["TurunOneChikanlari"]</h2>
        <ul class="hl-list">
            @foreach (var feature in Model.Tour.Features)
            {
                <li><span class="hl-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></span>@feature</li>
            }
        </ul>
    </div>

    <!-- ITINERARY -->
    <div class="content-block">
        <h2>@L["GunGunTurProgrami"]</h2>
        @foreach (var (day, i) in Model.Tour.DayPrograms.Select((d, i) => (d, i)))
        {
            <div class="itin-item @(i == 0 ? "open" : "")">
                <div class="itin-head" onclick="toggleDay(this)">
                    <span class="day-tag">@(i + 1). @L["gun"]</span>
                    <span class="itin-title">@day.Title</span>
                    <span class="itin-toggle">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                    </span>
                </div>
                <div class="itin-body" style="@(i == 0 ? "max-height:600px" : "max-height:0")">
                    <div class="itin-inner">
                        <p>@day.Description</p>
                        <div class="itin-tags">
                            @if (!string.IsNullOrEmpty(day.Accommodation))
                            {
                                <span>🏨 @day.Accommodation</span>
                            }
                            @if (!string.IsNullOrEmpty(day.Transport))
                            {
                                <span>🚌 @day.Transport</span>
                            }
                            @if (!string.IsNullOrEmpty(day.Meals))
                            {
                                <span>🍽️ @day.Meals</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- INCLUDES -->
    <div class="content-block">
        <div class="row g-4">
            <div class="col-md-6">
                <h2>@L["FiyataDahilOlanlar"]</h2>
                <ul class="inc-list">
                    @foreach (var include in Model.Tour.Included)
                    {
                        <li><span class="inc-yes"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></span>@include</li>
                    }
                </ul>
            </div>
            <div class="col-md-6">
                <h2>@L["FiyataDahilOlmayanlar"]</h2>
                <ul class="inc-list">
                    @foreach (var notinc in Model.Tour.NotIncluded)
                    {
                        <li><span class="inc-no"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></span>@notinc</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- INFO -->
    <div class="content-block">
        <h2>@L["TurBilgileri"]</h2>
        <div class="info-grid">
            <div class="info-cell"><div class="k">@L["TurSuresi"]</div><div class="v">@Model.Tour.Duration @L["gun"] / @Model.Tour.Night @L["Gece"]</div></div>
            <div class="info-cell"><div class="k">@L["BaslangicSehri"]</div><div class="v">@Model.Tour.DepartureCity</div></div>
            <div class="info-cell"><div class="k">@L["Ulasim"]</div><div class="v">@Model.Tour.Transport</div></div>
            <div class="info-cell"><div class="k">@L["Konaklama"]</div><div class="v">@Model.Tour.Accommodation</div></div>
            <div class="info-cell"><div class="k">@L["RehberDili"]</div><div class="v">@Model.Tour.GuideLanguage</div></div>
            <div class="info-cell"><div class="k">@L["GrupBuyukluk"]</div><div class="v">@L["Maks"] @Model.Tour.GroupSize @L["Kisi"]</div></div>
            <div class="info-cell"><div class="k">@L["Vize"]</div><div class="v">@Model.Tour.VisaInfo</div></div>
        </div>
        <div class="meet-note">
            <b>@L["Bulusma"]</b>
            <p>@Model.Tour.MeetingPoint</p>
        </div>
    </div>

    @{
        var avgRating = Model.Comments.Any()
            ? Model.Comments.Average(c => c.Rating)
            : 0;
        var totalReviews = Model.Comments.Count;

        var star5 = Model.Comments.Count(c => c.Rating == 5);
        var star4 = Model.Comments.Count(c => c.Rating == 4);
        var star3 = Model.Comments.Count(c => c.Rating == 3);
        var star2 = Model.Comments.Count(c => c.Rating == 2);
        var star1 = Model.Comments.Count(c => c.Rating == 1);

        int pct(int count) => totalReviews > 0 ? (int)Math.Round((double)count / totalReviews * 100) : 0;
    }

    <!-- REVIEWS -->
    <div class="content-block">
        <h2>@L["MisafirYorum"]</h2>
        <div class="rev-summary mb-3">
            <div class="rev-score">
                <div class="num">@avgRating.ToString("0.0")</div>
                <div class="stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        @Html.Raw(i <= (int)Math.Round(avgRating) ? "★" : "<span class='off'>★</span>")
                    }
                </div>
                <div class="cnt">@totalReviews @L["degerlendir"]</div>
            </div>
            <div class="rev-bars">
                <div class="bar-row"><span class="lab">5 @L["Yildiz"]</span><div class="bar-track"><div class="bar-fill" style="width:@pct(star5)%"></div></div><span class="pct">%@pct(star5)</span></div>
                <div class="bar-row"><span class="lab">4 @L["Yildiz"]</span><div class="bar-track"><div class="bar-fill" style="width:@pct(star4)%"></div></div><span class="pct">%@pct(star4)</span></div>
                <div class="bar-row"><span class="lab">3 @L["Yildiz"]</span><div class="bar-track"><div class="bar-fill" style="width:@pct(star3)%"></div></div><span class="pct">%@pct(star3)</span></div>
                <div class="bar-row"><span class="lab">2 @L["Yildiz"]</span><div class="bar-track"><div class="bar-fill" style="width:@pct(star2)%"></div></div><span class="pct">%@pct(star2)</span></div>
                <div class="bar-row"><span class="lab">1 @L["Yildiz"]</span><div class="bar-track"><div class="bar-fill" style="width:@pct(star1)%"></div></div><span class="pct">%@pct(star1)</span></div>
            </div>
        </div>

        @foreach (var comment in Model.Comments)
        {
            <div class="review-card">
                <div class="rev-user">
                    <div class="qa-avatar">@comment.UserInitials</div>
                    <div><b>@comment.UserFullName</b><span class="sub">@comment.TourName · @comment.CreatedAt.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span></div>
                    <span class="rev-stars">
                        @for (int i = 0; i <= 5; i++)
                        {
                            @Html.Raw(i <= comment.Rating ? "★" : "<span class='off'>★</span>")
                        }
                    </span>
                </div>
                <p>@comment.Content</p>
            </div>
        }

     

        <div class="write-box">
            <div>
                <b>@L["Katildinmi"]</b>
                <p>@L["DeneyimPaylas"]</p>
            </div>
            <button class="btn-teal" data-bs-toggle="modal" data-bs-target="#reviewModal">@L["YorumYaz"]</button>
        </div>
    </div>

    <!-- Q&A -->
    <div class="content-block">
        <h2>@L["TurHakkindaSorular"]</h2>
        @foreach (var question in Model.Questions)
        {
            <div class="qa-item">
                <div class="qa-q">
                    <span class="qa-avatar">@question.UserInitials</span>
                    <div><div class="who">@question.UserFullName</div><div class="txt">@question.Content</div></div>
                </div>
                @if (question.IsAnswered)
                {
                    <div class="qa-a"><span class="brand-mini">Travelio</span><span class="txt">@question.Answer</span></div>
                }
            </div>
        }

      
        <div class="ask-box">
            <div class="book-label" style="margin-top:0">@L["TurMerak"]</div>
            <textarea id="askInput" placeholder="@L["SoruYaz"]"></textarea>
            <button class="btn-teal mt-3" onclick="sendQuestion()">@L["SoruGonder"]</button>
            <div id="askOk" style="display:none;color:var(--teal-dark);font-weight:600;font-size:.9rem;margin-top:.8rem">@L["SorunAlindi"]</div>
        </div>
    </div>

</div>
