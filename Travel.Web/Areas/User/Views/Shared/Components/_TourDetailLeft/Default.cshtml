@model TourDetailViewModel

<div class="col-lg-8">

    <!-- ABOUT -->
    <div class="content-block">
        <h2>Tur Hakkında</h2>
        <p>@Model.Tour.Description</p>
        <p>@Model.Tour.ShortDescription</p>
    </div>

    <!-- HIGHLIGHTS -->
    <div class="content-block">
        <h2>Turun Öne Çıkanları</h2>
        <ul class="hl-list">
            @foreach (var feature in Model.Tour.Features)
            {
                <li><span class="hl-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></span>@feature</li>
            }
        </ul>
    </div>

    <!-- ITINERARY -->
    <div class="content-block">
        <h2>Gün Gün Tur Programı</h2>
        @foreach (var (day, i) in Model.Tour.DayPrograms.Select((d, i) => (d, i)))
        {
            <div class="itin-item @(i == 0 ? "open" : "")">
                <div class="itin-head" onclick="toggleDay(this)">
                    <span class="day-tag">@(i + 1). Gün</span>
                    <span class="itin-title">@day.Title</span>
                    <span class="itin-toggle">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                    </span>
                </div>
                <div class="itin-body" style="@(i == 0 ? "max-height:600px" : "max-height:0")">
                    <div class="itin-inner">
                        <p>@day.Description</p>
                        <div class="itin-tags">
                            @if (!string.IsNullOrEmpty(day.Accommodation))
                            {
                                <span>🏨 @day.Accommodation</span>
                            }
                            @if (!string.IsNullOrEmpty(day.Transport))
                            {
                                <span>🚌 @day.Transport</span>
                            }
                            @if (!string.IsNullOrEmpty(day.Meals))
                            {
                                <span>🍽️ @day.Meals</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- INCLUDES -->
    <div class="content-block">
        <div class="row g-4">
            <div class="col-md-6">
                <h2>Fiyata Dahil Olanlar</h2>
                <ul class="inc-list">
                    @foreach(var include in Model.Tour.Included)
                    {
                        <li><span class="inc-yes"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></span>@include</li>
                    }
                </ul>
            </div>
            <div class="col-md-6">
                <h2>Fiyata Dahil Olmayanlar</h2>
                <ul class="inc-list">
                    @foreach(var notinc in Model.Tour.NotIncluded)
                    {
                        <li><span class="inc-no"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></span>@notinc</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- INFO -->
    <div class="content-block">
        <h2>Tur Bilgileri</h2>
        <div class="info-grid">
            <div class="info-cell"><div class="k">Tur Süresi</div><div class="v">@Model.Tour.Duration Gün / @Model.Tour.Night Gece</div></div>
            <div class="info-cell"><div class="k">Başlangıç Şehri</div><div class="v">@Model.Tour.DepartureCity</div></div>
            <div class="info-cell"><div class="k">Ulaşım</div><div class="v">@Model.Tour.Transport</div></div>
            <div class="info-cell"><div class="k">Konaklama</div><div class="v">@Model.Tour.Accommodation</div></div>
            <div class="info-cell"><div class="k">Rehber Dili</div><div class="v">@Model.Tour.GuideLanguage</div></div>
            <div class="info-cell"><div class="k">Grup Büyüklüğü</div><div class="v">Maks. @Model.Tour.GroupSize kişi</div></div>
            <div class="info-cell"><div class="k">Vize</div><div class="v">@Model.Tour.VisaInfo</div></div>
        </div>
        <div class="meet-note">
            <b>Buluşma Noktası</b>
            <p>@Model.Tour.MeetingPoint</p>
        </div>
    </div>

    <!-- REVIEWS -->
    <div class="content-block">
        <h2>Misafir Yorumları</h2>
        <div class="rev-summary mb-3">
            <div class="rev-score">
                <div class="num">4.8</div>
                <div class="stars">★★★★★</div>
                <div class="cnt">1.687 değerlendirme</div>
            </div>
            <div class="rev-bars">
                <div class="bar-row"><span class="lab">5 yıldız</span><div class="bar-track"><div class="bar-fill" style="width:82%"></div></div><span class="pct">%82</span></div>
                <div class="bar-row"><span class="lab">4 yıldız</span><div class="bar-track"><div class="bar-fill" style="width:13%"></div></div><span class="pct">%13</span></div>
                <div class="bar-row"><span class="lab">3 yıldız</span><div class="bar-track"><div class="bar-fill" style="width:4%"></div></div><span class="pct">%4</span></div>
                <div class="bar-row"><span class="lab">2 yıldız</span><div class="bar-track"><div class="bar-fill" style="width:1%"></div></div><span class="pct">%1</span></div>
                <div class="bar-row"><span class="lab">1 yıldız</span><div class="bar-track"><div class="bar-fill" style="width:0%"></div></div><span class="pct">%0</span></div>
            </div>
        </div>

        @foreach(var comment in Model.Comments)
        {
            <div class="review-card">
                <div class="rev-user">
                    <div class="qa-avatar">@comment.UserInitials</div>
                    <div><b>@comment.UserFullName</b><span class="sub">@comment.TourName · @comment.CreatedAt.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span></div>
                    <span class="rev-stars">
                        @for(int i = 0; i <= 5; i++)
                        {
                            @(i <= comment.Rating ? "★" : "<span class='off'>★</span>")
                        }
                    </span>
                </div>
                <p>@comment.Content</p>
            </div>
        }
     


        <div class="write-box">
            <div>
                <b>Bu Tura Katıldın mı?</b>
                <p>Deneyimini diğer gezginlerle paylaş.</p>
            </div>
            <button class="btn-teal" data-bs-toggle="modal" data-bs-target="#reviewModal">Yorum Yaz</button>
        </div>
    </div>

    <!-- Q&A -->
    <div class="content-block">
        <h2>Tur Hakkında Sorular</h2>
        <div class="qa-item">
            <div class="qa-q">
                <span class="qa-avatar">AD</span>
                <div><div class="who">Ayşe Demir</div><div class="txt">Vatikan giriş bileti tur ücretine dahil mi?</div></div>
            </div>
            <div class="qa-a"><span class="brand-mini">Travelio</span><span class="txt">Vatikan müzeleri giriş ücretleri tur paketine dahil değildir. Güncel giriş ücretleri tur öncesinde misafirlerimizle paylaşılır.</span></div>
        </div>
        <div class="qa-item">
            <div class="qa-q">
                <span class="qa-avatar">MK</span>
                <div><div class="who">Mehmet Kaya</div><div class="txt">Tur sırasında serbest zamanımız olacak mı?</div></div>
            </div>
            <div class="qa-a"><span class="brand-mini">Travelio</span><span class="txt">Evet. Roma ve Floransa programlarında misafirlerimizin bireysel keşif yapabilmesi için serbest zaman bulunmaktadır.</span></div>
        </div>
        <div class="qa-item">
            <div class="qa-q">
                <span class="qa-avatar">SA</span>
                <div><div class="who">Selin Arslan</div><div class="txt">Schengen vizem yok, vize hizmeti veriyor musunuz?</div></div>
            </div>
            <div class="qa-a"><span class="brand-mini">Travelio</span><span class="txt">Tur paketine vize ücreti dahil değildir ancak gerekli evrak süreci konusunda danışmanlık sağlanmaktadır.</span></div>
        </div>

        <div class="ask-box">
            <div class="book-label" style="margin-top:0">Bu tur hakkında merak ettiğin bir şey mi var?</div>
            <textarea id="askInput" placeholder="Sorunu yaz..."></textarea>
            <button class="btn-teal mt-3" onclick="sendQuestion()">Soru Gönder</button>
            <div id="askOk" style="display:none;color:var(--teal-dark);font-weight:600;font-size:.9rem;margin-top:.8rem">Sorun alındı! Ekibimiz en kısa sürede yanıtlayacak.</div>
        </div>
    </div>

</div>
