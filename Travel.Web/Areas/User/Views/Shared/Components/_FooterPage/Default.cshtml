@inject Microsoft.Extensions.Localization.IStringLocalizer<Travel.Web.SharedResource> L

<footer>
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <a class="brand mb-3" href="#"><span class="dot"></span>Travelio</a>
                <p style="max-width:34ch">@L["FooterAciklama"]</p>
                <div class="foot-social mt-3">
                    <a href="#" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg></a>
                    <a href="#" aria-label="Twitter"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4.01c-1 .49-1.98.689-3 .99-1.121-1.265-2.783-1.335-4.38-.737S11.977 6.323 12 8v1c-3.245.083-6.135-1.395-8-4 0 0-4.182 7.433 4 11-1.872 1.247-3.739 2.088-6 2 3.308 1.803 6.913 2.423 10.034 1.517 3.58-1.04 6.522-3.723 7.651-7.742a13.84 13.84 0 0 0 .497-3.753c-.002-.249 1.51-2.772 1.818-4.013z" /></svg></a>
                    <a href="#" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg></a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <h6>@L["Kesfet"]</h6>
                <a href="#turlar">@L["Turlar"]</a>
                <a href="#destinasyonlar">@L["Destinasyonlar"]</a>
                <a href="#yorumlar">@L["Yorumlar"]</a>
                <a href="#">@L["Kampanyalar"]</a>
            </div>
            <div class="col-6 col-lg-2">
                <h6>@L["Kurumsal"]</h6>
                <a href="#hakkimizda">@L["Hakkimizda"]</a>
                <a href="#">@L["Kariyer"]</a>
                <a href="#">@L["Blog"]</a>
                <a href="#iletisim">@L["Iletisim"]</a>
            </div>
            <div class="col-lg-4">
                <h6>@L["BulteneKatil"]</h6>
                <p style="max-width:36ch">@L["BulteneKatilAciklama"]</p>
                <div class="d-flex gap-2 mt-2" style="max-width:360px">
                    <input class="form-control" style="border-radius:999px" placeholder="@L["EpostaAdresin"]" />
                    <button class="btn-teal" style="white-space:nowrap">@L["Katil"]</button>
                </div>
            </div>
        </div>
        <div class="foot-bottom d-flex flex-wrap justify-content-between gap-2">
            <span>@L["FooterTelif"]</span>
            <span>@L["FooterLinkler"]</span>
        </div>
    </div>
</footer>
