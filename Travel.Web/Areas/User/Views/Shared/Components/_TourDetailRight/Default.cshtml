@model TourDetailViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Travel.Web.SharedResource> L


<div class="col-lg-4">
    <div class="book-sticky">
        <div class="book-card">
            <div class="price-top">
                <small>@L["KisiBasi"]</small>
                <div class="big" id="unitPrice">@Model.Tour.Price <span>TL</span></div>
                <div class="price-note">@L["Vergi"]</div>
            </div>

            <div class="book-label">@L["TurTarihi"]</div>
            <div id="dateOptions">
                @foreach (var (date, i) in Model.Tour.Dates.Select((d, i) => (d, i)))
                {
                    <label class="date-opt @(i == 0 ? "sel" : "")">
                        <span class="d">@date.StartDate.ToLocalTime().ToString("dd") - @date.EndDate.ToLocalTime().ToString("dd MMM yyyy")</span>
                        <input type="radio" name="tourDate" value="@date.Id" @(i == 0 ? "checked" : "") @(date.Quota == 0 ? "disabled" : "") />
                        @if (date.Quota == 0)
                        {
                            <span class="left" style="color:#c0554f;font-weight:600">@L["KontenjanDoldu"]</span>
                        }
                        else if (date.Quota <= 5)
                        {
                            <span class="left" style="color:#c0554f;font-weight:600">Son @date.Quota @L["Kontenjan"]!</span>
                        }
                        else
                        {
                            <span class="left" style="color:var(--muted)">@date.Quota @L["Kontenjan"]</span>
                        }
                    </label>
                }
            </div>

            <div class="book-label">@L["KisiSayisi"]</div>
            <div class="counter-row">
                <div class="cl"><b>@L["Adult"]</b><span>@L["yasveuzeri"]</span></div>
                <div class="counter">
                    <button onclick="changeCount('adult',-1)" id="adultMinus">−</button>
                    <span class="val" id="adultVal">0</span>
                    <button onclick="changeCount('adult',1)">+</button>
                </div>
            </div>
            <div class="counter-row">
                <div class="cl"><b>@L["Child"]</b><span>2 - 11 @L["Yas"]</span></div>
                <div class="counter">
                    <button onclick="changeCount('child',-1)" id="childMinus">−</button>
                    <span class="val" id="childVal">0</span>
                    <button onclick="changeCount('child',1)">+</button>
                </div>
            </div>

            <div class="summary">
                <div class="row-line"><span id="adultLine">1 @L["Adult"]</span><b id="adultSum">@Model.Tour.Price.ToString("N0") TL</b></div>
                <div class="row-line" id="childRow" style="display:none"><span id="childLine">1 @L["Child"]</span><b id="childSum">@Model.Tour.ChildPrice.ToString("N0") TL</b></div>
                <div class="row-line"><span>@L["AraToplam"]</span><b id="subtotal">@Model.Tour.Price.ToString("N0") TL</b></div>
                <div class="total"><span>@L["Toplam"]</span><b id="grandTotal">@Model.Tour.Price.ToString("N0") TL</b></div>
            </div>

            <button class="btn-teal" id="reserveBtn" data-tour-id="@Model.Tour.Id" onclick="reserve()">@L["RezervasyonYap"]</button>
            <div class="trust">
                <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg> @L["GuvenliRezervasyon"]</span>
                <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg> @L["OnRezervasyon"]</span>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-labelledby="loginRequiredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none; padding: 10px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="loginRequiredModalLabel">@L["GirisGerekiyor"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div style="font-size: 3rem; margin-bottom: 15px;">🔒</div>
                <p class="text-muted mb-0">@L["HesapGiris"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius: 8px;">@L["Vazgec"]</button>
                <a href="/User/Account/Login?returnUrl=@Context.Request.Path" class="btn btn-teal px-4" style="border-radius: 8px; background-color: var(--teal, #0d9488); color: white; text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">@L["GirisYap"]</a>
            </div>
        </div>
    </div>
</div>