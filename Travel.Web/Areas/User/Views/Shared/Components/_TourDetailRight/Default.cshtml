@model ResultTourDto

<div class="col-lg-4">
    <div class="book-sticky">
        <div class="book-card">
            <div class="price-top">
                <small>Kişi başı</small>
                <div class="big" id="unitPrice">@Model.Price <span>TL</span></div>
                <div class="price-note">Vergiler ve belirtilen hizmetler dahildir.</div>
            </div>

            <div class="book-label">Tur Tarihi</div>
            <div id="dateOptions">
                @foreach (var (date, i) in Model.Dates.Select((d, i) => (d, i)))
                {
                    <label class="date-opt @(i == 0 ? "sel" : "")">
                        <span class="d">@date.StartDate.ToLocalTime().ToString("dd") - @date.EndDate.ToLocalTime().ToString("dd MMM yyyy")</span>
                        <input type="radio" name="tourDate" value="@date.Id" @(i == 0 ? "checked" : "") />
                        @if (date.Quota <= 5 && date.Quota > 0)
                        {
                            <span class="left">Son @date.Quota Kontenjan</span>
                        }
                    </label>
                }
            </div>

            <div class="book-label">Kişi Sayısı</div>
            <div class="counter-row">
                <div class="cl"><b>Yetişkin</b><span>12 yaş ve üzeri</span></div>
                <div class="counter">
                    <button onclick="changeCount('adult',-1)" id="adultMinus">−</button>
                    <span class="val" id="adultVal">0</span>
                    <button onclick="changeCount('adult',1)">+</button>
                </div>
            </div>
            <div class="counter-row">
                <div class="cl"><b>Çocuk</b><span>2 - 11 yaş</span></div>
                <div class="counter">
                    <button onclick="changeCount('child',-1)" id="childMinus">−</button>
                    <span class="val" id="childVal">0</span>
                    <button onclick="changeCount('child',1)">+</button>
                </div>
            </div>

            <div class="summary">
                <div class="row-line"><span id="adultLine">1 Yetişkin</span><b id="adultSum">@Model.Price.ToString("N0") TL</b></div>
                <div class="row-line" id="childRow" style="display:none"><span id="childLine">1 Çocuk</span><b id="childSum">@Model.ChildPrice.ToString("N0") TL</b></div>
                <div class="row-line"><span>Ara Toplam</span><b id="subtotal">@Model.Price.ToString("N0") TL</b></div>
                <div class="total"><span>Toplam</span><b id="grandTotal">@Model.Price.ToString("N0") TL</b></div>
            </div>

            <button class="btn-teal" id="reserveBtn" data-tour-id="@Model.Id" onclick="reserve()">Rezervasyon Yap</button>
            <div class="trust">
                <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg> Güvenli rezervasyon</span>
                <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg> Ücretsiz ön rezervasyon</span>
            </div>
        </div>
    </div>
</div>
