@inject Microsoft.Extensions.Localization.IStringLocalizer<Travel.Web.SharedResource> L
@model HeroViewModel

<header class="hero">
    <div class="container hero-content">
        <div class="eyebrow mb-3">@L["HeroEyebrow"]</div>
        <h1>@L["HeroBaslik"]</h1>
        <p class="lead">@L["HeroAciklama"]</p>
        <form asp-controller="Tour" asp-action="Index" method="get" class="search-box">
            <div class="row g-0 align-items-center">
                <div class="col-md-3 search-field">
                    <label>@L["Destinasyon"]</label>
                    <select class="control" name="destination">
                        <option value="">@L["Nereye"]</option>
                        @if (Model.Destination != null)
                        {
                            @foreach (var item in Model.Destination)
                            {
                                <option value="@item.Country">@item.Country</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 search-field">
                    <label>@L["Tarih"]</label>
                    <input class="control" type="date" name="date" />
                </div>
                <div class="col-md-3 search-field">
                    <label>@L["KisiSayisi"]</label>
                    <select class="control" name="personCount">
                        <option value="1">1 @L["Kisi"]</option>
                        <option value="2" selected>2 @L["Kisi"]</option>
                        <option value="3">3 @L["Kisi"]</option>
                        <option value="4">4 @L["Kisi"]</option>
                        <option value="5">5+ @L["Kisi"]</option>
                    </select>
                </div>
                <div class="col-md-3 p-2">
                    <button type="submit" class="btn-teal">@L["Turları Ara"]</button>
                </div>
            </div>
        </form>

        <div class="stats-row">
            <div class="stat"><b>@Model.DestinationCount</b><span>@L["Destinasyonlar"]</span></div>
            <div class="stat"><b>@Model.TourCount</b><span>@L["Turlar"]</span></div>
            <div class="stat"><b>@Model.TravelerCount.ToString("N0")</b><span>@L["Mutlu Gezgin"]</span></div>
        </div>
    </div>
</header>