@model HeroViewModel

<header class="hero">
    <div class="container hero-content">
        <div class="eyebrow mb-3">Travelio ile keşfet</div>
        <h1>Dünyayı Keşfetmeye Hazır Mısın?</h1>
        <p class="lead">Avrupa'nın ikonik şehirlerinden Uzak Doğu'nun benzersiz rotalarına kadar unutulmaz deneyimler seni bekliyor.</p>

        <form asp-controller="Tour" asp-action="Index" method="get" class="search-box">
            <div class="row g-0 align-items-center">
                <div class="col-md-3 search-field">
                    <label>Destinasyon</label>
                    <select class="control" name="destination">
                        <option value="">Nereye gidelim?</option>
                        @if (Model.Destination != null)
                        {
                            @foreach (var item in Model.Destination)
                            {
                                <option value="@item.Country">@item.Country</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 search-field">
                    <label>Tarih</label>
                    <input class="control" type="date" name="date" />
                </div>
                <div class="col-md-3 search-field">
                    <label>Kişi Sayısı</label>
                    <select class="control" name="personCount">
                        <option value="1">1 kişi</option>
                        <option value="2" selected>2 kişi</option>
                        <option value="3">3 kişi</option>
                        <option value="4">4 kişi</option>
                        <option value="5">5+ kişi</option>
                    </select>
                </div>
                <div class="col-md-3 p-2">
                    <button type="submit" class="btn-teal">Turları Ara</button>
                </div>
            </div>
        </form>

        <div class="stats-row">
            <div class="stat"><b>@Model.DestinationCount</b><span>Destinasyon</span></div>
            <div class="stat"><b>@Model.TourCount</b><span>Rehberli Tur</span></div>
            <div class="stat"><b>@Model.TravelerCount.ToString("N0")</b><span>Mutlu Gezgin</span></div>
        </div>
    </div>
</header>