@using X.PagedList
@model IPagedList<ResultTourDto>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    /* ---------- DATA ---------- */
    const TOURS = @Html.Raw(Json.Serialize(Model.Select(t => new
        {
            id = t.Id,
            title = t.Name,
            country = t.Country,
            ctry = (t.DestinationName ?? "").ToLower(),
            dur = t.Duration,
            durLabel = t.Duration,
            price = t.Price,
            cat = t.CategoryName,
            catLabel = t.CategoryName,
            badge = t.IsFeatured ? "Popüler" : "",
            img = t.CoverImage ?? "",
            rating = t.AverageRating,
            reviews = t.ReviewCount,
            isFeatured = t.IsFeatured,
            isBest = t.IsBest,
            isNew = t.IsNew,
         })));


         const L = {
    day: '@L["gun"]',
    perPerson: '@L["KisiBasi"]',
    viewTour: '@L["TuruIncele"]',
    popular: '@L["Populer"]',
    bestSeller: '@L["CokSatan"]',
    new: '@L["Yeni"]',
    veuzeri: '@L["veuzeri"]',      
    gunveuzeri: '@L["GunveUzeri"]',
    destinasyon: '@L["Destinasyon"]',
    tursuresi: '@L["TurSuresi"]',
    fiyataraligi: '@L["FiyatAraligi"]',
    turtipi: '@L["TurTipi"]',
    turara: '@L["TurAra"]',
    filtretemizle: '@L["FiltreleriTemizle"]',
    filtreuygula: '@L["FiltreleriUygula"]',
    turfiltrele: '@L["TurlariFiltrele"]',
    enuygunrota: '@L["EnUygunRota"]',
    searchPlaceholder: '@L["TurVeyaDestinasyonAra"]',
    degerlendirme: '@L["Degerlendirme"]'

};

  
    /* ---------- FILTER OPTIONS ---------- */
    const DEST_OPTS = [...new Set(TOURS.map(t => t.ctry))].filter(Boolean).map(ctryName => {
        const originalTour = TOURS.find(t => t.ctry === ctryName);
        return {
            key: ctryName,
            label: originalTour ? originalTour.country : ctryName
        };
    });
    // const DEST_OPTS = [
    //     { key: "fransa", label: "Fransa" }, { key: "italya", label: "İtalya" }, { key: "ispanya", label: "İspanya" },
    //     { key: "hollanda", label: "Hollanda" }, { key: "avusturya", label: "Avusturya" }, { key: "isvicre", label: "İsviçre" },
    //     { key: "norvec", label: "Norveç" }, { key: "japonya", label: "Japonya" }, { key: "portekiz", label: "Portekiz" }
    // ];
    const DUR_OPTS = [
        { key: "1-3", label: `1 - 3 ${L.day}`, min: 1, max: 3 },
        { key: "4-5", label: `4 - 5 ${L.day}`, min: 4, max: 5 },
        { key: "6-7", label: `6 - 7 ${L.day}`, min: 6, max: 7 },
        { key: "8+", label: `${L.gunveuzeri}`, min: 8, max: 99 }
    ];
    const PRICE_OPTS = [
        { key: "p1", label: "0 - 25.000 ₺", min: 0, max: 25000 },
        { key: "p2", label: "25.000 - 40.000 ₺", min: 25000, max: 40000 },
        { key: "p3", label: "40.000 - 60.000 ₺", min: 40000, max: 60000 },
        { key: "p4", label: `60.000 ₺ ${L.veuzeri}`, min: 60000, max: 9999999 }
    ];
    const TYPE_OPTS = [...new Set(TOURS.map(t => t.cat))].filter(Boolean);
    const RATING_OPTS = [
        { key: "r45", label: `4.5 ${L.veuzeri}`, val: 4.5, stars: 5 },
        { key: "r40", label: `4.0 ${L.veuzeri}`, val: 4.0, stars: 4 },
        { key: "r35", label: `3.5 ${L.veuzeri}`, val: 3.5, stars: 3 }
    ];

    /* ---------- STATE ---------- */
    const state = { q: "", dest: [], dur: [], price: [], type: [], rating: null, sort: "onerilen" };

    /* ---------- BUILD SIDEBAR HTML ---------- */
    function destCount(key) { return TOURS.filter(t => t.ctry === key).length; }
    function starsMarkup(n) { let s = ""; for (let i = 1; i <= 5; i++) { s += i <= n ? "★" : "<span class='off'>★</span>"; } return s; }

    function sidebarHTML() {
        // CSS stillerini doğrudan fonksiyonun içine ekledik, ayrı dosya ile uğraşmazsın
        const styles = `
            <style>
                .filter-dropdown-group {
                    background: #ffffff;
                    border: 1px solid #e5e7eb;
                    border-radius: 8px;
                    margin-bottom: 12px;
                    padding: 12px 16px;
                    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
                }
                .filter-summary {
                    font-size: 0.85rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.03em;
                    color: var(--navy, #111827);
                    cursor: pointer;
                    list-style: none;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    user-select: none;
                }
                .filter-summary::-webkit-details-marker {
                    display: none;
                }
                .filter-summary::after {
                    content: "⌄";
                    font-size: 1.2rem;
                    font-weight: 600;
                    transition: transform 0.2s ease;
                    color: var(--muted, #6b7280);
                }
                .filter-dropdown-group[open] .filter-summary::after {
                    transform: rotate(180deg);
                }
                .filter-content {
                    margin-top: 12px;
                    padding-top: 8px;
                    border-top: 1px solid #f3f4f6;
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                }
            </style>
        `;

        return styles + `
            <h2>${L.turfiltrele}</h2>
            <p class="filter-sub">${L.enuygunrota}</p>

            <div class="filter-group">
                <h3>${L.turara}</h3>
                <div class="search-wrap" style="margin-top: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" class="f-search" placeholder="${L.searchPlaceholder}" />
                </div>
            </div>

            <details class="filter-dropdown-group" open>
                <summary class="filter-summary">${L.destinasyon}</summary>
                <div class="filter-content">
                    ${DEST_OPTS.map(o => `
                      <label class="fcheck">
                        <span class="lbl"><input type="checkbox" class="f-dest" value="${o.key}"> ${o.label}</span>
                        <span class="cnt">(${destCount(o.key)})</span>
                      </label>`).join("")}
                </div>
            </details>

            <details class="filter-dropdown-group" open>
                <summary class="filter-summary">${L.tursuresi}</summary>
                <div class="filter-content">
                    ${DUR_OPTS.map(o => `
                      <label class="fcheck">
                        <span class="lbl"><input type="checkbox" class="f-dur" value="${o.key}"> ${o.label}</span>
                      </label>`).join("")}
                </div>
            </details>

            <details class="filter-dropdown-group" open>
                <summary class="filter-summary">${L.fiyataraligi}</summary>
                <div class="filter-content">
                    ${PRICE_OPTS.map(o => `
                      <label class="fcheck">
                        <span class="lbl"><input type="checkbox" class="f-price" value="${o.key}"> ${o.label}</span>
                      </label>`).join("")}
                </div>
            </details>

            <details class="filter-dropdown-group" open>
                <summary class="filter-summary">${L.turtipi}</summary>
                <div class="filter-content">
                    ${TYPE_OPTS.map(o => `
                      <label class="fcheck">
                        <span class="lbl"><input type="checkbox" class="f-type" value="${o}"> ${o}</span>
                      </label>`).join("")}
                </div>
            </details>

            <details class="filter-dropdown-group" open>
                <summary class="filter-summary">${L.degerlendirme}</summary>
                <div class="filter-content">
                    ${RATING_OPTS.map(o => `
                      <label class="fcheck">
                        <span class="lbl"><input type="radio" name="f-rating" class="f-rating" value="${o.key}"> <span class="stars-opt">${starsMarkup(o.stars)}</span></span>
                        <span class="cnt">${o.label}</span>
                      </label>`).join("")}
                </div>
            </details>

            <div class="filter-actions" style="margin-top: 20px;">
                <button class="btn-teal" onclick="applyFromButton()">${L.filtreuygula}</button>
                <button class="clear-link" onclick="clearFilters()">${L.filtretemizle}</button>
            </div>`;
    }

    document.getElementById("filterCardDesktop").innerHTML = sidebarHTML();
    document.getElementById("filterCardMobile").innerHTML = sidebarHTML();

    /* ---------- READ INPUTS -> STATE ---------- */
    function syncState() {
        const q = document.querySelector(".f-search")?.value.trim().toLowerCase() || "";
        state.q = q;
        state.dest = [...document.querySelectorAll(".f-dest:checked")].map(i => i.value);
        state.dur = [...document.querySelectorAll(".f-dur:checked")].map(i => i.value);
        state.price = [...document.querySelectorAll(".f-price:checked")].map(i => i.value);
        state.type = [...document.querySelectorAll(".f-type:checked")].map(i => i.value);
        const r = document.querySelector(".f-rating:checked");
        state.rating = r ? r.value : null;
        state.dest = [...new Set(state.dest)];
        state.dur = [...new Set(state.dur)];
        state.price = [...new Set(state.price)];
        state.type = [...new Set(state.type)];
    }

    /* ---------- FILTER + SORT ---------- */
    function getFiltered() {
        let list = TOURS.filter(t => {
            if (state.q) {
                const hay = (t.title + " " + t.country).toLowerCase();
                if (!hay.includes(state.q)) return false;
            }
            if (state.dest.length && !state.dest.includes(t.ctry)) return false;
            if (state.dur.length) {
                const ok = state.dur.some(k => { const o = DUR_OPTS.find(d => d.key === k); return t.dur >= o.min && t.dur <= o.max; });
                if (!ok) return false;
            }
            if (state.price.length) {
                const ok = state.price.some(k => { const o = PRICE_OPTS.find(p => p.key === k); return t.price >= o.min && t.price < o.max; });
                if (!ok) return false;
            }
            if (state.type.length && !state.type.includes(t.cat)) return false;
            if (state.rating) {
                const o = RATING_OPTS.find(r => r.key === state.rating);
                if (t.rating < o.val) return false;
            }
            return true;
        });

        switch (state.sort) {
            case "puan": list.sort((a, b) => b.rating - a.rating); break;
            case "fiyat-artan": list.sort((a, b) => a.price - b.price); break;
            case "fiyat-azalan": list.sort((a, b) => b.price - a.price); break;
            case "yeni": list.sort((a, b) => b.added - a.added); break;
            default: break;
        }
        return list;
    }

    /* ---------- RENDER CARDS ---------- */
    function fmt(n) { return n.toLocaleString("tr-TR"); }

    function cardHTML(t) {
        return `
                    <div class="col-md-6">
                      <article class="tour-card">
                        <div class="tour-media">
                          <img src="${t.img}" alt="${t.title}" loading="lazy" />

                          <!-- Dinamik Rozetler -->
                          <div class="tour-badges-wrapper" style="position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; z-index: 2;">
    ${t.isFeatured ? `<span style="background: var(--teal, #0d9488); color: white; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">${L.popular}</span>` : ''}
    ${t.isBest ? `<span style="background: #e11d48; color: white; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">${L.bestSeller}</span>` : ''}
    ${t.isNew ? `<span style="background: #2563eb; color: white; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">${L.new}</span>` : ''}
</div>

                          <button class="fav" aria-label="Favorilere ekle" data-tour-id="${t.id}" onclick="toggleFavorite(this)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                          </button>
                        </div>
                        <div class="tour-body">
                          <div class="tour-topline">
                            <span class="tour-country">${t.country}</span>
                            <span class="tour-cat">${t.catLabel}</span>
                          </div>
                          <h3 class="tour-title">${t.title}</h3>
                          <div class="tour-meta">
                            <span>🗓️ ${t.durLabel} ${L.day}</span>
                            <span class="rating"><span class="star">★</span> ${t.rating.toFixed(1)} <span style="color:var(--muted);font-weight:400">(${fmt(t.reviews)})</span></span>
                          </div>
                          <div class="tour-foot">
                            <div class="price"><small>${L.perPerson}</small><b>${fmt(t.price)} <span>TL</span></b></div>
                            <a href="/User/Tour/Detail/${t.id}" class="btn-incele">${L.viewTour}</a>
                          </div>
                        </div>
                      </article>
                    </div>`;
    }

    /* ---------- ACTIVE CHIPS ---------- */
    function chipsHTML() {
        const chips = [];
        state.dest.forEach(k => { const o = DEST_OPTS.find(d => d.key === k); chips.push({ t: o.label, kind: "dest", v: k }); });
        state.dur.forEach(k => { const o = DUR_OPTS.find(d => d.key === k); chips.push({ t: o.label, kind: "dur", v: k }); });
        state.price.forEach(k => { const o = PRICE_OPTS.find(p => p.key === k); chips.push({ t: o.label, kind: "price", v: k }); });
        state.type.forEach(v => chips.push({ t: v, kind: "type", v }));
        if (state.rating) { const o = RATING_OPTS.find(r => r.key === state.rating); chips.push({ t: o.label + " ★", kind: "rating", v: state.rating }); }
        if (state.q) chips.push({ t: '"' + state.q + '"', kind: "q", v: state.q });
        return chips.map(c => `<span class="chip" onclick="removeChip('${c.kind}','${(c.v + '').replace(/'/g, "")}')">${c.t} <span class="x">×</span></span>`).join("");
    }

    function removeChip(kind, v) {
        const uncheck = (sel, val) => document.querySelectorAll(sel).forEach(i => { if (i.value === val) i.checked = false; });
        if (kind === "dest") uncheck(".f-dest", v);
        if (kind === "dur") uncheck(".f-dur", v);
        if (kind === "price") uncheck(".f-price", v);
        if (kind === "type") uncheck(".f-type", v);
        if (kind === "rating") document.querySelectorAll(".f-rating").forEach(i => i.checked = false);
        if (kind === "q") document.querySelectorAll(".f-search").forEach(i => i.value = "");
        syncState(); render();
    }

    /* ---------- MAIN RENDER ---------- */
    function render() {
        const list = getFiltered();
        const grid = document.getElementById("tourGrid");
        const empty = document.getElementById("emptyState");
        const pager = document.getElementById("pager");

        const countEl = document.getElementById("resultCount");
        if (countEl) countEl.textContent = list.length;

        document.getElementById("activeChips").innerHTML = chipsHTML();

        if (list.length === 0) {
            grid.innerHTML = "";
            empty.style.display = "block";
            pager.style.display = "none";
        } else {
            grid.innerHTML = list.map(cardHTML).join("");
            empty.style.display = "none";
            pager.style.display = list.length > 6 ? "flex" : "none";
        }

        loadUserFavorites();
    }

    /* ---------- EVENTS ---------- */
    // live filtering on any change / typing
    document.addEventListener("input", (e) => {
    if (e.target.matches(".f-search")) {
        syncState(); render();
    }
});
    document.getElementById("sortSelect").addEventListener("change", (e) => {
        state.sort = e.target.value; render();
    });

    function applyFromButton() {
        syncState(); render();
        const oc = document.getElementById("filterOffcanvas");
        const inst = bootstrap.Offcanvas.getInstance(oc);
        if (inst) inst.hide();
    }

    function clearFilters() {
        document.querySelectorAll(".f-search").forEach(i => i.value = "");
        document.querySelectorAll(".f-dest,.f-dur,.f-price,.f-type").forEach(i => i.checked = false);
        document.querySelectorAll(".f-rating").forEach(i => i.checked = false);
        state.sort = "onerilen";
        document.getElementById("sortSelect").value = "onerilen";
        syncState(); render();
    }

    function toggleFavorite(btn) {
        const tourId = btn.dataset.tourId;
        const isOn = btn.classList.contains("on");
        const url = isOn ? "/User/Favorite/Delete" : "/User/Favorite/Add";

        fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ tourId: tourId })
        }).then(r => {
            if (r.ok) {
                btn.classList.toggle("on");
            } else {
                alert("İşlem başarısız");
            }
        });
    }

    function applyUrlParams() {
        const params = new URLSearchParams(window.location.search);
        const destination = params.get("destination");

        if (destination) {
            const destLower = destination.toLowerCase().trim();
            
            const matched = DEST_OPTS.find(o => o.label.toLowerCase() === destLower || o.key === destLower);
            
            if (matched) {
                const chk = document.querySelector(`.f-dest[value='${matched.key}']`);
                if (chk) {
                    chk.checked = true;
                }
                if (!state.dest.includes(matched.key)) {
                    state.dest.push(matched.key);
                }
            } else {
                state.q = destLower;
                const searchInput = document.querySelector(".f-search");
                if (searchInput) searchInput.value = destination;
            }
            render();
        }
    }

    function loadUserFavorites() {
        fetch('/User/Favorite/GetUserFavorites')
            .then(r => r.json())
            .then(favoriteIds => {
                document.querySelectorAll('.fav[data-tour-id]').forEach(btn => {
                    if (favoriteIds.includes(btn.dataset.tourId)) {
                        btn.classList.add('on');
                    }
                });
            });
    }

    loadUserFavorites();
    render();
    applyUrlParams();

    // initial
</script>