
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleFavorite(btn) {
        const tourId = btn.dataset.tourId;
        const isOn = btn.classList.contains("on");
        fetch(isOn ? "/User/Favorite/Delete" : "/User/Favorite/Add", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ tourId: tourId })
        }).then(r => {
            if (r.ok) btn.classList.toggle("on");
        });
    }

    function loadUserFavorites() {
        fetch('/User/Favorite/GetUserFavorites')
            .then(r => r.json())
            .then(favoriteItems => {

                if (!Array.isArray(favoriteItems)) return;

                const favoriteIds = favoriteItems.map(f => f.tourId || f.TourId);

                document.querySelectorAll('.fav[data-tour-id]').forEach(btn => {
                    if (favoriteIds.includes(btn.dataset.tourId)) {
                        btn.classList.add('on');
                    }
                });
            });
    }

    loadUserFavorites();
</script>