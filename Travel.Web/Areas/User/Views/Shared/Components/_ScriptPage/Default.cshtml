    const grid = document.getElementById('tourGrid');
    grid.innerHTML = tours.map(o => `
                    <div class="col-md-6 col-lg-4">
                      <article class="tour-card">
                        <div class="tour-media">
                          <img src="${o.img}" alt="${o.t}" loading="lazy" />
