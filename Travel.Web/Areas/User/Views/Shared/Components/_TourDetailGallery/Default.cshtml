@model ResultTourDto

<div class="gallery">
    <div class="row">
        <div class="col-lg-6">
            <div class="g-wrap">
                <img class="g-img g-main" src="@Model.CoverImage" alt="@Model.Name" />
            </div>
        </div>
        <div class="col-lg-6">
            <div class="row">
                @for(int i = 0; i < Math.Min(4, Model.Gallery.Count); i++)
                {
                    <div class="col-6">
                        <div class="g-wrap">
                            <img class="g-img g-small" src="@Model.Gallery[i]" alt="@Model.Name" />
                            @if (i == 3 && Model.Gallery.Count > 4)
                            {
                                <span class="g-more">+@(Model.Gallery.Count - 4) fotoğraf</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
