@inject Microsoft.Extensions.Localization.IStringLocalizer<Travel.Web.SharedResource> L
@model List<ResultWhyUsItemDto>

<section id="hakkimizda">
    <div class="container">
        <div class="section-head mb-5">
            <div class="eyebrow">@L["NedenBiz"]</div>
            <h2>@L["NedenTravelio"]</h2>
            <p>@L["NedenTravelioAciklama"]</p>
        </div>
        <div class="row g-4">
            @foreach(var item in Model)
            {
                <div class="col-md-4">
                    <div class="why-card">
                        <div class="why-ico">
                            <i class="@item.Icon" style="font-size: 24px;"></i>
                        </div>
                        <h4>@item.Title</h4>
                        <p>@item.Description</p>
                    </div>
                </div>
            }
          
        </div>
    </div>
</section>
